@model List<Hostel_hub.Models.Feedback>

@{
    ViewData["Title"] = "Student Feedback";

    int totalFeedback = Model.Count;

    double averageRating =
        Model.Any()
            ? Model.Average(f => f.Rating)
            : 0;

    int positiveFeedback =
        Model.Count(f => f.Rating >= 4);

    int fiveStarFeedback =
        Model.Count(f => f.Rating == 5);
}

<style>
    .feedback-page {
        padding: 35px 0 60px;
    }

    .feedback-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .feedback-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .feedback-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .summary-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        height: 100%;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.82rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .filter-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        margin-top: 25px;
    }

    .filter-row {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .filter-label {
        color: #465064;
        font-weight: 600;
        margin-bottom: 0;
    }

    .filter-select {
        min-width: 220px;
        height: 44px;
        border-radius: 9px;
    }

    .feedback-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-top: 24px;
    }

    .feedback-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .feedback-card-header h5 {
        margin-bottom: 3px;
        font-weight: 700;
        color: #172033;
    }

    .feedback-table {
        margin-bottom: 0;
    }

    .feedback-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
        white-space: nowrap;
    }

    .feedback-table tbody td {
        padding: 17px 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }

    .student-name {
        color: #172033;
        font-weight: 700;
    }

    .source-badge {
        display: inline-block;
        background: #eaf2ff;
        color: #0d6efd;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 0.76rem;
        font-weight: 600;
    }

    .complaint-title {
        color: #465064;
        font-weight: 500;
    }

    .no-complaint {
        color: #9aa2af;
    }

    .rating-box {
        min-width: 125px;
    }

    .rating-number {
        font-size: 1rem;
        font-weight: 700;
        color: #172033;
    }

    .stars {
        margin-top: 3px;
        white-space: nowrap;
    }

    .star-filled {
        color: #ffc107;
    }

    .star-empty {
        color: #d9dee7;
    }

    .feedback-comment {
        max-width: 300px;
        color: #566174;
        line-height: 1.5;
    }

    .submitted-date {
        color: #6c757d;
        font-size: 0.86rem;
        white-space: nowrap;
    }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #fff4d6;
        color: #997404;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-weight: 700;
    }

    .empty-state h5 {
        color: #172033;
        font-weight: 700;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 0;
    }

    @@media (max-width: 767px) {
        .feedback-page {
            padding-top: 20px;
        }

        .feedback-header h2 {
            font-size: 1.7rem;
        }

        .filter-select {
            width: 100%;
        }

        .feedback-comment {
            max-width: 220px;
        }
    }
</style>


<div class="feedback-page">

    <!-- HEADER -->
    <div class="feedback-header">

        <div>

            <h2>Student Feedback</h2>

            <p>
                Review student ratings and comments about hostel services.
            </p>

        </div>

    </div>


    <!-- SUMMARY -->
    <div class="row g-3">

        <div class="col-md-3 col-sm-6">

            <div class="summary-card">

                <div class="summary-label">
                    Total Feedback
                </div>

                <p class="summary-number">
                    @totalFeedback
                </p>

            </div>

        </div>


        <div class="col-md-3 col-sm-6">

            <div class="summary-card">

                <div class="summary-label">
                    Average Rating
                </div>

                <p class="summary-number text-warning">

                    @averageRating.ToString("0.0")
                    <span style="font-size: 1rem;">
                        / 5
                    </span>

                </p>

            </div>

        </div>


        <div class="col-md-3 col-sm-6">

            <div class="summary-card">

                <div class="summary-label">
                    Positive Ratings
                </div>

                <p class="summary-number text-success">
                    @positiveFeedback
                </p>

            </div>

        </div>


        <div class="col-md-3 col-sm-6">

            <div class="summary-card">

                <div class="summary-label">
                    5-Star Feedback
                </div>

                <p class="summary-number text-primary">
                    @fiveStarFeedback
                </p>

            </div>

        </div>

    </div>


    <!-- FILTER -->
    <div class="filter-card">

        <form method="get">

            <div class="filter-row">

                <label class="filter-label">
                    Filter by source:
                </label>


                <select name="source"
                        class="form-select filter-select"
                        onchange="this.form.submit()">

                    <option value="">
                        All Sources
                    </option>


                    @foreach (var s in Enum.GetValues(
                        typeof(Hostel_hub.Models.FeedbackSource)))
                    {
                        bool isSelected =
                            ViewBag.SelectedSource?.ToString()
                            == s.ToString();

                        if (isSelected)
                        {
                            <option value="@s" selected>
                                @s
                            </option>
                        }
                        else
                        {
                            <option value="@s">
                                @s
                            </option>
                        }
                    }

                </select>

            </div>

        </form>

    </div>


    <!-- FEEDBACK LIST -->
    <div class="feedback-card">

        <div class="feedback-card-header">

            <h5>Feedback Records</h5>

            <span class="text-muted small">

                @Model.Count feedback record(s) currently displayed

            </span>

        </div>


        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    FB
                </div>

                <h5>No feedback found</h5>

                <p>
                    No student feedback matches the selected filter.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover feedback-table">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th>Source</th>
                            <th>Related Complaint</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Submitted</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var f in Model)
                        {
                            <tr>

                                <!-- STUDENT -->
                                <td>

                                    <span class="student-name">

                                        @(f.Student?.FullName
                                            ?? "Unknown Student")

                                    </span>

                                </td>


                                <!-- SOURCE -->
                                <td>

                                    <span class="source-badge">
                                        @f.Source
                                    </span>

                                </td>


                                <!-- COMPLAINT -->
                                <td>

                                    @if (f.Complaint != null)
                                    {
                                        <span class="complaint-title">

                                            @f.Complaint.Title

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="no-complaint">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- RATING -->
                                <td>

                                    <div class="rating-box">

                                        <div class="rating-number">
                                            @f.Rating / 5
                                        </div>


                                        <div class="stars">

                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= f.Rating)
                                                {
                                                    <span class="star-filled">
                                                        ★
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="star-empty">
                                                        ★
                                                    </span>
                                                }
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- COMMENTS -->
                                <td>

                                    <div class="feedback-comment">

                                        @if (string.IsNullOrWhiteSpace(f.Comments))
                                        {
                                            <span class="text-muted">
                                                No comment provided.
                                            </span>
                                        }
                                        else
                                        {
                                            @f.Comments
                                        }

                                    </div>

                                </td>


                                <!-- SUBMITTED -->
                                <td>

                                    <span class="submitted-date">

                                        @(f.SubmittedAt.ToString(
                                            "dd MMM yyyy, hh:mm tt"))

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>