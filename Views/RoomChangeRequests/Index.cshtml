@model List<Hostel_hub.Models.RoomChangeRequest>

@{
    ViewData["Title"] = "Room Change Requests";
}

<style>
    .room-requests-page {
        padding: 35px 0 60px;
    }

    .room-requests-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .room-requests-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .room-requests-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .pending-badge {
        background: #fff3cd;
        color: #997404;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .summary-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        margin-bottom: 26px;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .requests-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .requests-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .requests-card-header h5 {
        margin-bottom: 0;
        font-weight: 700;
        color: #172033;
    }

    .requests-table {
        margin-bottom: 0;
    }

    .requests-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
    }

    .requests-table tbody td {
        padding: 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }

    .student-name {
        display: block;
        font-weight: 700;
        color: #273142;
        margin-bottom: 3px;
    }

    .student-roll {
        color: #8a94a3;
        font-size: 0.82rem;
    }

    .room-badge {
        display: inline-block;
        background: #eef4ff;
        color: #0d6efd;
        padding: 7px 11px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .requested-room {
        min-width: 145px;
    }

    .occupancy-text {
        display: block;
        margin-top: 6px;
        color: #7c8798;
        font-size: 0.78rem;
    }

    .available-badge {
        display: inline-block;
        margin-top: 6px;
        padding: 4px 8px;
        border-radius: 20px;
        background: #d1e7dd;
        color: #146c43;
        font-size: 0.73rem;
        font-weight: 600;
    }

    .full-badge {
        display: inline-block;
        margin-top: 6px;
        padding: 4px 8px;
        border-radius: 20px;
        background: #f8d7da;
        color: #b02a37;
        font-size: 0.73rem;
        font-weight: 600;
    }

    .reason-text {
        max-width: 300px;
        color: #4f5968;
        line-height: 1.5;
    }

    .request-date {
        white-space: nowrap;
        color: #394355;
    }

    .request-time {
        display: block;
        margin-top: 3px;
        color: #8a94a3;
        font-size: 0.8rem;
    }

    .request-actions {
        display: flex;
        justify-content: flex-end;
        gap: 7px;
        flex-wrap: wrap;
    }

    .request-actions .btn {
        border-radius: 8px;
        font-weight: 600;
        min-width: 82px;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #d1e7dd;
        color: #146c43;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-weight: 700;
        font-size: 1.2rem;
    }

    .empty-state h5 {
        font-weight: 700;
        color: #172033;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 0;
    }

    @@media (max-width: 767px) {
        .room-requests-page {
            padding-top: 20px;
        }

        .room-requests-header h2 {
            font-size: 1.7rem;
        }
    }
</style>


<div class="room-requests-page">

    <!-- HEADER -->
    <div class="room-requests-header">

        <div>

            <h2>Room Change Requests</h2>

            <p>
                Review student requests and approve or reject room changes.
            </p>

        </div>


        <span class="pending-badge">
            @Model.Count Pending
        </span>

    </div>


    <!-- MESSAGES -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- SUMMARY -->
    <div class="row">

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Requests Awaiting Review
                </div>

                <p class="summary-number text-warning">
                    @Model.Count
                </p>

            </div>

        </div>

    </div>


    <!-- REQUEST LIST -->
    <div class="requests-card">

        <div class="requests-card-header">

            <div>

                <h5>
                    Pending Requests
                </h5>

                <span class="text-muted small">
                    Review room availability before approval.
                </span>

            </div>

        </div>


        @if (!Model.Any())
        {

            <div class="empty-state">

                <div class="empty-icon">
                    ✓
                </div>

                <h5>No pending requests</h5>

                <p>
                    All room change requests have been reviewed.
                </p>

            </div>

        }
        else
        {

            <div class="table-responsive">

                <table class="table table-hover requests-table">

                    <thead>

                        <tr>

                            <th>Student</th>

                            <th>Current Room</th>

                            <th>Requested Room</th>

                            <th>Reason</th>

                            <th>Requested At</th>

                            <th class="text-end">
                                Decision
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var req in Model)
                        {
                            bool requestedRoomFull =
                                req.RequestedRoom != null &&
                                req.RequestedRoom.CurrentOccupancy >=
                                req.RequestedRoom.Capacity;


                            <tr>

                                <!-- STUDENT -->
                                <td>

                                    <span class="student-name">

                                        @(req.Student?.FullName
                                            ?? "Unknown Student")

                                    </span>


                                    <span class="student-roll">

                                        @(req.Student?.RollNumber
                                            ?? "No roll number")

                                    </span>

                                </td>


                                <!-- CURRENT ROOM -->
                                <td>

                                    @if (req.CurrentRoom != null)
                                    {
                                        <span class="room-badge">

                                            Room @req.CurrentRoom.RoomNumber

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not assigned
                                        </span>
                                    }

                                </td>


                                <!-- REQUESTED ROOM -->
                                <td>

                                    @if (req.RequestedRoom != null)
                                    {
                                        <div class="requested-room">

                                            <span class="room-badge">

                                                Room @req.RequestedRoom.RoomNumber

                                            </span>


                                            <span class="occupancy-text">

                                                @req.RequestedRoom.CurrentOccupancy
                                                /
                                                @req.RequestedRoom.Capacity
                                                occupied

                                            </span>


                                            @if (requestedRoomFull)
                                            {
                                                <span class="full-badge">
                                                    Full
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="available-badge">
                                                    Space Available
                                                </span>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Room unavailable
                                        </span>
                                    }

                                </td>


                                <!-- REASON -->
                                <td>

                                    <div class="reason-text">
                                        @req.Reason
                                    </div>

                                </td>


                                <!-- DATE -->
                                <td>

                                    <span class="request-date">

                                        @(req.RequestedAt
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy"))

                                    </span>


                                    <span class="request-time">

                                        @(req.RequestedAt
                                            .ToLocalTime()
                                            .ToString("hh:mm tt"))

                                    </span>

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="request-actions">

                                        <form asp-action="Approve"
                                              asp-route-id="@req.RoomChangeRequestId"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('Approve this room change request?');">

                                                Approve

                                            </button>

                                        </form>


                                        <form asp-action="Reject"
                                              asp-route-id="@req.RoomChangeRequestId"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Reject this room change request?');">

                                                Reject

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</div>