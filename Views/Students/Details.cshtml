@model Hostel_hub.Models.Student

<h2>Student Details</h2>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Roll Number</dt>
    <dd class="col-sm-9">@Model.RollNumber</dd>

    <dt class="col-sm-3">Phone Number</dt>
    <dd class="col-sm-9">@(Model.PhoneNumber ?? "Not provided")</dd>

    <dt class="col-sm-3">Hostel</dt>
    <dd class="col-sm-9">@(Model.Hostel?.Name ?? "Not yet assigned")</dd>

    <dt class="col-sm-3">Room</dt>
    <dd class="col-sm-9">@(Model.Room?.RoomNumber ?? "Not yet assigned")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>