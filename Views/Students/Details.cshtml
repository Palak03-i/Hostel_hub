@model Hostel_hub.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<style>
    .student-details-page {
        padding: 35px 0 60px;
    }

    .student-details-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .student-details-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .student-details-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .student-badge {
        background: #eaf2ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .details-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        height: 100%;
    }

    .details-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .details-card-header h5 {
        margin-bottom: 0;
        font-weight: 700;
        color: #172033;
    }

    .details-card-body {
        padding: 24px;
    }

    .detail-item {
        padding: 15px 0;
        border-bottom: 1px solid #f0f2f5;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: #8a94a3;
        margin-bottom: 6px;
    }

    .detail-value {
        font-size: 1.05rem;
        font-weight: 600;
        color: #273142;
        margin-bottom: 0;
    }

    .hostel-card {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.16);
        margin-bottom: 22px;
    }

    .hostel-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: rgba(255,255,255,0.7);
    }

    .hostel-name {
        font-size: 1.6rem;
        font-weight: 700;
        margin-top: 6px;
        margin-bottom: 22px;
    }

    .room-box {
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 12px;
        padding: 18px;
    }

    .room-number {
        font-size: 1.6rem;
        font-weight: 700;
        margin-top: 4px;
    }

    .unassigned-box {
        background: #f8f9fc;
        border-radius: 12px;
        padding: 18px;
        color: #6c757d;
        font-weight: 500;
    }

    .back-btn {
        margin-top: 26px;
        padding: 9px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .student-details-page {
            padding-top: 20px;
        }

        .student-details-header h2 {
            font-size: 1.7rem;
        }
    }
</style>


<div class="student-details-page">

    <!-- HEADER -->
    <div class="student-details-header">

        <div>
            <h2>Student Details</h2>

            <p>
                View student profile and hostel allocation information.
            </p>
        </div>

        <span class="student-badge">
            Student
        </span>

    </div>


    <div class="row g-4">

        <!-- STUDENT INFORMATION -->
        <div class="col-lg-6">

            <div class="details-card">

                <div class="details-card-header">

                    <h5>
                        Student Information
                    </h5>

                </div>


                <div class="details-card-body">

                    <div class="detail-item">

                        <span class="detail-label">
                            Full Name
                        </span>

                        <p class="detail-value">
                            @Model.FullName
                        </p>

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Roll Number
                        </span>

                        <p class="detail-value">
                            @Model.RollNumber
                        </p>

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Phone Number
                        </span>

                        <p class="detail-value">

                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                ? "Not provided"
                                : Model.PhoneNumber)

                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- HOSTEL / ROOM -->
        <div class="col-lg-6">

            @if (Model.Hostel != null)
            {
                <div class="hostel-card">

                    <span class="hostel-label">
                        Assigned Hostel
                    </span>

                    <div class="hostel-name">
                        @Model.Hostel.Name
                    </div>


                    <div class="room-box">

                        <span class="hostel-label">
                            Room Allocation
                        </span>


                        @if (Model.Room != null)
                        {
                            <div class="room-number">
                                Room @Model.Room.RoomNumber
                            </div>
                        }
                        else
                        {
                            <div class="mt-2 fw-semibold">
                                Room not assigned
                            </div>
                        }

                    </div>

                </div>
            }
            else
            {
                <div class="details-card">

                    <div class="details-card-header">

                        <h5>
                            Hostel Information
                        </h5>

                    </div>

                    <div class="details-card-body">

                        <div class="unassigned-box">
                            This student has not been assigned to a hostel yet.
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- BACK -->
    <a asp-action="Index"
       class="btn btn-outline-secondary back-btn">

        ← Back to Students

    </a>

</div>