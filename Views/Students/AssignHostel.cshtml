@model Hostel_hub.Models.Student

@{
    ViewData["Title"] = "Assign Hostel";

    var hostels =
        (List<Hostel_hub.Models.Hostel>)ViewBag.Hostels;
}

<style>
    .assign-hostel-page {
        padding: 35px 0 60px;
    }

    .assign-header {
        margin-bottom: 28px;
    }

    .assign-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .assign-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .assign-card {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .assign-card-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .assign-card-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .assign-card-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .assign-card-body {
        padding: 28px;
    }

    .student-summary {
        background: #eef5ff;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 24px;
    }

    .summary-label {
        color: #718096;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 4px;
    }

    .summary-value {
        color: #172033;
        font-weight: 700;
        margin-bottom: 14px;
    }

    .summary-value:last-child {
        margin-bottom: 0;
    }

    .form-label-custom {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .hostel-select {
        min-height: 50px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .hostel-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.12);
    }

    .info-box {
        background: #fff8e1;
        border-left: 4px solid #ffc107;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #665c3b;
        font-size: 0.9rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }
</style>


<div class="assign-hostel-page">

    <div class="assign-header">

        <h2>Assign Hostel</h2>

        <p>
            Assign this newly registered student to a hostel.
        </p>

    </div>


    <div class="assign-card">

        <div class="assign-card-header">

            <h5>
                Student Hostel Assignment
            </h5>

            <p>
                After assignment, the student will become visible to that hostel's Warden.
            </p>

        </div>


        <div class="assign-card-body">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }


            <div class="student-summary">

                <div class="summary-label">
                    Student Name
                </div>

                <div class="summary-value">
                    @Model.FullName
                </div>


                <div class="summary-label">
                    Roll Number
                </div>

                <div class="summary-value">
                    @Model.RollNumber
                </div>


                <div class="summary-label">
                    Current Hostel
                </div>

                <div class="summary-value">
                    Not Assigned
                </div>

            </div>


            <div class="info-box">
                This is the student's initial hostel assignment.
                After assigning a hostel, the Warden can allocate the student to a room.
            </div>


            <form asp-action="AssignHostel"
                  asp-route-id="@Model.StudentId"
                  method="post">

                @Html.AntiForgeryToken()


                <div>

                    <label class="form-label-custom">
                        Select Hostel
                    </label>


                    <select name="hostelId"
                            class="form-select hostel-select"
                            required>

                        <option value="">
                            Select hostel
                        </option>


                        @foreach (var hostel in hostels)
                        {
                            <option value="@hostel.HostelId">
                                @hostel.Name (@hostel.Type)
                            </option>
                        }

                    </select>

                </div>


                <div class="form-actions">

                    <a asp-action="Details"
                       asp-route-id="@Model.StudentId"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Assign Hostel

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>