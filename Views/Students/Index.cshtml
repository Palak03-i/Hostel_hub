@model List<Hostel_hub.Models.Student>

@{
    ViewData["Title"] = "Manage Students";

    string currentSearch =
        Context.Request.Query["search"].ToString();

    int assignedStudents =
        Model.Count(s => s.Room != null);

    int unassignedStudents =
        Model.Count(s => s.Room == null);
}

<style>
    .students-page {
        padding: 35px 0 60px;
    }

    .students-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .students-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .students-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .warden-badge {
        background: #eaf2ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .student-table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        margin-top: 26px;
    }

    .table-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .table-card-header h5 {
        margin-bottom: 0;
        font-weight: 700;
        color: #172033;
    }

    .search-box {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .search-input {
        min-width: 280px;
        border-radius: 9px;
    }

    .search-btn {
        border-radius: 9px;
        padding-left: 18px;
        padding-right: 18px;
        font-weight: 600;
    }

    .students-table {
        margin-bottom: 0;
    }

    .students-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
    }

    .students-table tbody td {
        padding: 17px 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }

    .student-name {
        font-weight: 700;
        color: #273142;
    }

    .roll-number {
        color: #5d6878;
        font-weight: 500;
    }

    .hostel-badge {
        display: inline-block;
        background: #eef4ff;
        color: #0d6efd;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .room-badge {
        display: inline-block;
        background: #d1e7dd;
        color: #146c43;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .unassigned-badge {
        display: inline-block;
        background: #f1f3f5;
        color: #6c757d;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .view-btn {
        border-radius: 8px;
        font-weight: 600;
        padding: 6px 13px;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-weight: 700;
    }

    .empty-state h5 {
        font-weight: 700;
        color: #172033;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 0;
    }

    @@media (max-width: 767px) {

        .students-page {
            padding-top: 20px;
        }

        .students-header h2 {
            font-size: 1.7rem;
        }

        .search-box {
            width: 100%;
        }

        .search-input {
            min-width: 100%;
            width: 100%;
        }

        .search-btn {
            width: 100%;
        }
    }
</style>


<div class="students-page">

    <!-- HEADER -->
    <div class="students-header">

        <div>

            <h2>Manage Students</h2>

            <p>
                View hostel students and their current room allocations.
            </p>

        </div>


        <span class="warden-badge">
            Hostel Students
        </span>

    </div>


    <!-- SUMMARY -->
    <div class="row g-3">

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Total Students
                </div>

                <p class="summary-number">
                    @Model.Count
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Room Assigned
                </div>

                <p class="summary-number text-success">
                    @assignedStudents
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Room Not Assigned
                </div>

                <p class="summary-number text-warning">
                    @unassignedStudents
                </p>

            </div>

        </div>

    </div>


    <!-- STUDENT TABLE -->
    <div class="student-table-card">

        <div class="table-card-header">

            <div>

                <h5>
                    Student Directory
                </h5>

                <span class="text-muted small">
                    @Model.Count student(s)
                </span>

            </div>


            <!-- SEARCH -->
            <form method="get"
                  class="search-box">

                <input type="text"
                       name="search"
                       value="@currentSearch"
                       class="form-control search-input"
                       placeholder="Search by name or roll number" />


                <button type="submit"
                        class="btn btn-primary search-btn">

                    Search

                </button>


                @if (!string.IsNullOrWhiteSpace(currentSearch))
                {

                    <a asp-action="Index"
                       class="btn btn-outline-secondary search-btn">

                        Clear

                    </a>

                }

            </form>

        </div>


        @if (!Model.Any())
        {

            <div class="empty-state">

                <div class="empty-icon">
                    ST
                </div>

                <h5>No students found</h5>

                <p>

                    @if (!string.IsNullOrWhiteSpace(currentSearch))
                    {
                        <span>
                            No student matched your search.
                        </span>
                    }
                    else
                    {
                        <span>
                            There are currently no students available.
                        </span>
                    }

                </p>

            </div>

        }
        else
        {

            <div class="table-responsive">

                <table class="table table-hover students-table">

                    <thead>

                        <tr>

                            <th>Student</th>

                            <th>Roll Number</th>

                            <th>Hostel</th>

                            <th>Room</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var student in Model)
                        {

                            <tr>

                                <!-- NAME -->
                                <td>

                                    <span class="student-name">
                                        @student.FullName
                                    </span>

                                </td>


                                <!-- ROLL -->
                                <td>

                                    <span class="roll-number">
                                        @student.RollNumber
                                    </span>

                                </td>


                                <!-- HOSTEL -->
                                <td>

                                    @if (student.Hostel != null)
                                    {

                                        <span class="hostel-badge">
                                            @student.Hostel.Name
                                        </span>

                                    }
                                    else
                                    {

                                        <span class="unassigned-badge">
                                            Not assigned
                                        </span>

                                    }

                                </td>


                                <!-- ROOM -->
                                <td>

                                    @if (student.Room != null)
                                    {

                                        <span class="room-badge">
                                            Room @student.Room.RoomNumber
                                        </span>

                                    }
                                    else
                                    {

                                        <span class="unassigned-badge">
                                            Not assigned
                                        </span>

                                    }

                                </td>


                                <!-- ACTION -->
                                <td class="text-end">

    <div class="d-flex gap-2 justify-content-end flex-wrap">

        <a asp-action="Details"
           asp-route-id="@student.StudentId"
           class="btn btn-outline-primary btn-sm view-btn">

            View Details

        </a>


        @if (ViewBag.IsSuperAdmin == true &&
             !student.HostelId.HasValue)
        {
            <a asp-action="AssignHostel"
               asp-route-id="@student.StudentId"
               class="btn btn-primary btn-sm view-btn">

                Assign Hostel

            </a>
        }

    </div>

</td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</div>