@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card shadow-sm border-0 my-4">
    <div class="card-header bg-white py-3">
        <h4 class="mb-0">Privacy Policy</h4>
    </div>
    <div class="card-body p-4">
        <p class="text-secondary">
            HostelHub respects your privacy and is dedicated to safeguarding student and staff data within the system.
        </p>
        <h6 class="fw-bold mt-4 mb-2">Data Protection &amp; Security</h6>
        <p class="text-muted">
            All user credentials, room assignments, maintenance logs, and dietary records are strictly isolated using role-based access control. Password records are hashed using industry-standard cryptography.
        </p>
        <h6 class="fw-bold mt-4 mb-2">Usage Policies</h6>
        <p class="text-muted mb-0">
            Internal activity logs and status changes are recorded solely for operational transparency, auditing, and maintenance coordination.
        </p>
    </div>
</div>
