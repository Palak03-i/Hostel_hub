                                </span>

                            </div>

                        </div>


                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary register-btn">

                                Create Student Account

                            </button>

                        </div>

                    </form>


                    <div class="login-link-area">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">
                            Sign in
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}