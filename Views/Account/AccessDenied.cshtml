@{
    ViewData["Title"] = "Access Denied";
}

<style>
    .access-denied-container {
        padding: 60px 15px 80px;
        min-height: calc(100vh - 220px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .access-denied-card {
        max-width: 600px;
        width: 100%;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
        padding: 48px 40px;
        text-align: center;
        border: 1px solid #edf0f5;
    }

    .access-denied-badge {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background: #fff8eb;
        color: #d97706;
        border: 1px solid #ffeeba;
        margin-bottom: 20px;
    }

    .access-denied-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #fffbeb;
        color: #d97706;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 2.2rem;
    }

    .access-denied-title {
        font-size: 2rem;
        font-weight: 750;
        color: #172033;
        margin-bottom: 12px;
    }

    .access-denied-message {
        color: #6c757d;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .access-denied-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-denied-home {
        padding: 11px 26px;
        border-radius: 10px;
        font-weight: 600;
        background: #0d6efd;
        border-color: #0d6efd;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-denied-home:hover {
        background: #0b5ed7;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-denied-back {
        padding: 11px 22px;
        border-radius: 10px;
        font-weight: 600;
    }
</style>

<div class="access-denied-container">
    <div class="access-denied-card">
        <div class="access-denied-badge">
            Security 403
        </div>

        <div class="access-denied-icon">
            🔒
        </div>

        <h1 class="access-denied-title">
            Access Denied
        </h1>

        <p class="access-denied-message">
            You do not have permission to access this page or resource. If you believe this is in error, please contact your hostel administrator.
        </p>

        <div class="access-denied-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-denied-home">
                &larr; Back to Home
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-denied-back">
                Previous Page
            </a>
        </div>
    </div>
</div>