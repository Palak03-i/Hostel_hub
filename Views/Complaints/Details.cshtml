@model Hostel_hub.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details";

    string statusClass =
        Model.Status.ToString() switch
        {
            "Pending" => "status-pending",
            "Assigned" => "status-assigned",
            "InProgress" => "status-progress",
            "Resolved" => "status-resolved",
            _ => "status-default"
        };

    string priorityClass =
        Model.Priority.ToString() switch
        {
            "High" => "priority-high",
            "Medium" => "priority-medium",
            "Low" => "priority-low",
            _ => "priority-default"
        };

    var history =
        (List<Hostel_hub.Models.ComplaintStatusHistory>)ViewBag.History;
}

<style>
    .complaint-details-page {
        padding: 35px 0 60px;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .details-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .details-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .status-badge,
    .priority-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 30px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-pending {
        background: #fff3cd;
        color: #997404;
    }

    .status-assigned {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .status-progress {
        background: #cff4fc;
        color: #087990;
    }

    .status-resolved {
        background: #d1e7dd;
        color: #146c43;
    }

    .status-default {
        background: #eceff3;
        color: #495057;
    }

    .priority-high {
        background: #f8d7da;
        color: #b02a37;
    }

    .priority-medium {
        background: #fff3cd;
        color: #997404;
    }

    .priority-low {
        background: #d1e7dd;
        color: #146c43;
    }

    .priority-default {
        background: #eceff3;
        color: #495057;
    }

    .details-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        height: 100%;
    }

    .details-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .details-card-header h5 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 0;
    }

    .details-card-body {
        padding: 24px;
    }

    .detail-item {
        padding: 14px 0;
        border-bottom: 1px solid #f0f2f5;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        display: block;
        color: #8a94a3;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 6px;
    }

    .detail-value {
        color: #273142;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0;
    }

    .description-box {
        background: #f8f9fc;
        border-radius: 10px;
        padding: 18px;
        color: #4f5968;
        line-height: 1.7;
    }

    .management-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-top: 26px;
    }

    .management-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .management-header h5 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .management-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .management-body {
        padding: 24px;
    }

    .management-box {
        background: #f8f9fc;
        border-radius: 12px;
        padding: 18px;
        height: 100%;
    }

    .management-box h6 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .management-box p {
        color: #7b8494;
        font-size: 0.85rem;
        margin-bottom: 16px;
    }

    .management-select {
        min-height: 46px;
        border-radius: 9px;
    }

    .management-btn {
        border-radius: 9px;
        font-weight: 600;
        min-height: 42px;
    }

    .assigned-staff-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 9px;
        padding: 15px 18px;
        margin-bottom: 20px;
    }

    .assigned-staff-label {
        color: #6f7b8e;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .assigned-staff-name {
        color: #172033;
        font-weight: 700;
        margin-top: 4px;
    }

    .resolved-box {
        background: #d1e7dd;
        color: #146c43;
        border-radius: 10px;
        padding: 16px;
        font-weight: 600;
    }

    .history-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-top: 26px;
    }

    .history-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .history-header h5 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 0;
    }

    .timeline {
        padding: 28px;
    }

    .timeline-item {
        position: relative;
        padding-left: 34px;
        padding-bottom: 28px;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-item::before {
        content: "";
        position: absolute;
        left: 8px;
        top: 18px;
        width: 2px;
        height: calc(100% - 4px);
        background: #e2e6ec;
    }

    .timeline-item:last-child::before {
        display: none;
    }

    .timeline-dot {
        position: absolute;
        left: 0;
        top: 3px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #0d6efd;
        border: 4px solid #eaf2ff;
    }

    .timeline-title {
        color: #273142;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .timeline-meta {
        color: #7c8798;
        font-size: 0.86rem;
    }

    .empty-history {
        padding: 40px;
        text-align: center;
        color: #6c757d;
    }

    .back-btn {
        margin-top: 26px;
        border-radius: 9px;
        padding: 9px 18px;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .complaint-details-page {
            padding-top: 20px;
        }

        .details-header h2 {
            font-size: 1.7rem;
        }
    }
</style>


<div class="complaint-details-page">

    <!-- HEADER -->
    <div class="details-header">

        <div>

            <h2>@Model.Title</h2>

            <p>
                Review complaint details and manage its resolution.
            </p>

        </div>


        <div class="d-flex gap-2 flex-wrap">

            <span class="priority-badge @priorityClass">
                @Model.Priority Priority
            </span>


            <span class="status-badge @statusClass">

                @(Model.Status.ToString() == "InProgress"
                    ? "In Progress"
                    : Model.Status.ToString())

            </span>

        </div>

    </div>


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- DETAILS -->
    <div class="row g-4">

        <!-- BASIC INFORMATION -->
        <div class="col-lg-5">

            <div class="details-card">

                <div class="details-card-header">

                    <h5>
                        Complaint Information
                    </h5>

                </div>


                <div class="details-card-body">

                    <div class="detail-item">

                        <span class="detail-label">
                            Student
                        </span>

                        <p class="detail-value">

                            @(Model.Student?.FullName
                                ?? "Unknown Student")

                        </p>

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Category
                        </span>

                        <p class="detail-value">
                            @Model.Category
                        </p>

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Priority
                        </span>

                        <span class="priority-badge @priorityClass">
                            @Model.Priority
                        </span>

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Current Status
                        </span>

                        <span class="status-badge @statusClass">

                            @(Model.Status.ToString() == "InProgress"
                                ? "In Progress"
                                : Model.Status.ToString())

                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- DESCRIPTION -->
        <div class="col-lg-7">

            <div class="details-card">

                <div class="details-card-header">

                    <h5>
                        Complaint Description
                    </h5>

                </div>


                <div class="details-card-body">

                    <div class="description-box">
                        @Model.Description
                    </div>


                    <div class="assigned-staff-box">

                        <div class="assigned-staff-label">
                            Assigned Maintenance Staff
                        </div>

                        <div class="assigned-staff-name">

                            @(Model.AssignedStaff?.FullName
                                ?? "Not yet assigned")

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MANAGEMENT -->
    <div class="management-card">

        <div class="management-header">

            <h5>Complaint Management</h5>

            <p>
                Set complaint priority and assign appropriate maintenance staff.
            </p>

        </div>


        <div class="management-body">

            <div class="row g-4">

                <!-- PRIORITY -->
                <div class="col-lg-6">

                    <div class="management-box">

                        <h6>
                            Set Priority
                        </h6>

                        <p>
                            Update the urgency level of this complaint.
                        </p>


                        <form asp-action="SetPriority"
                              asp-route-id="@Model.ComplaintId"
                              method="post">

                            <div class="d-flex gap-2 flex-wrap">

                                <select name="priority"
                                        class="form-select management-select flex-grow-1">

                                    @foreach (
                                        var p in
                                        Enum.GetValues<Hostel_hub.Models.ComplaintPriority>())
                                    {
                                        <option value="@p"
                                                selected="@(p == Model.Priority)">

                                            @p

                                        </option>
                                    }

                                </select>


                                <button type="submit"
                                        class="btn btn-primary management-btn">

                                    Update Priority

                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- ASSIGN STAFF -->
                <div class="col-lg-6">

                    <div class="management-box">

                        <h6>
                            Assign Maintenance Staff
                        </h6>

                        <p>
                            Assign a maintenance staff member from this hostel.
                        </p>


                        @if (Model.Status != Hostel_hub.Models.ComplaintStatus.Resolved)
                        {
                            var staffList =
                                (List<Hostel_hub.Models.MaintenanceStaff>)
                                ViewBag.StaffList;


                            @if (staffList.Any())
                            {
                                <form asp-action="Assign"
                                      asp-route-id="@Model.ComplaintId"
                                      method="post">

                                    <div class="d-flex gap-2 flex-wrap">

                                        <select name="staffId"
                                                class="form-select management-select flex-grow-1"
                                                required>

                                            <option value="">
                                                Select maintenance staff
                                            </option>


                                            @foreach (var s in staffList)
                                            {
                                                <option value="@s.MaintenanceStaffId">

                                                    @s.FullName
                                                    (@s.Specialization)

                                                </option>
                                            }

                                        </select>


                                        <button type="submit"
                                                class="btn btn-success management-btn">

                                            Assign Staff

                                        </button>

                                    </div>

                                </form>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">

                                    No maintenance staff are available for this hostel.

                                </div>
                            }
                        }
                        else
                        {
                            <div class="resolved-box">

                                ✓ Complaint resolved — staff assignment is closed.

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- HISTORY -->
    <div class="history-card">

        <div class="history-header">

            <h5>
                Status History
            </h5>

            <span class="text-muted small">
                @history.Count update(s)
            </span>

        </div>


        @if (!history.Any())
        {
            <div class="empty-history">

                No status history is available yet.

            </div>
        }
        else
        {
            <div class="timeline">

                @foreach (var h in history)
                {
                    <div class="timeline-item">

                        <div class="timeline-dot">
                        </div>


                        <div class="timeline-title">

                            @h.OldStatus
                            →
                            @h.NewStatus

                        </div>


                        <div class="timeline-meta">

                            @(h.ChangedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy, hh:mm tt"))

                            &nbsp;•&nbsp;

                            Updated by @h.ChangedBy

                        </div>

                    </div>
                }

            </div>
        }

    </div>


    <!-- BACK -->
    <a asp-action="Index"
       class="btn btn-outline-secondary back-btn">

        ← Back to Complaints

    </a>

</div>