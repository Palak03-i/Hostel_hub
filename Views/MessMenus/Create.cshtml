@model Hostel_hub.ViewModels.MessMenuViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Mess Menu";
}

<style>
    .create-menu-page {
        padding: 35px 0 60px;
    }

    .create-menu-header {
        margin-bottom: 28px;
    }

    .create-menu-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .create-menu-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .menu-form-card {
        max-width: 1000px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .menu-form-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .menu-form-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .menu-form-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .menu-form-body {
        padding: 28px;
    }

    .info-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #49566a;
        font-size: 0.9rem;
    }

    .form-label-custom {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .menu-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .menu-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.12);
    }

    .meal-section {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 20px;
        height: 100%;
    }

    .meal-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .meal-section-header h5 {
        margin-bottom: 0;
        font-weight: 700;
        color: #172033;
    }

    .meal-toggle {
        background: white;
        border: 1px solid #e1e5eb;
        border-radius: 20px;
        padding: 7px 12px;
    }

    .meal-textarea {
        min-height: 130px;
        resize: vertical;
        border-radius: 9px;
    }

    .meal-help {
        margin-top: 7px;
        color: #8a94a3;
        font-size: 0.8rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {
        .create-menu-page {
            padding-top: 20px;
        }

        .menu-form-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<div class="create-menu-page">

    <!-- HEADER -->
    <div class="create-menu-header">

        <h2>Create Mess Menu</h2>

        <p>
            Publish a daily meal schedule for hostel students.
        </p>

    </div>


    <div class="menu-form-card">

        <!-- CARD HEADER -->
        <div class="menu-form-header">

            <h5>Menu Information</h5>

            <p>
                Select the hostel and date, then configure each meal.
            </p>

        </div>


        <div class="menu-form-body">

            <div class="info-box">
                Create menus only for valid upcoming/current dates.
                Students will see only the meals marked as available.
            </div>


            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- BASIC INFORMATION -->
                <div class="row g-4 mb-4">

                    <div class="col-md-6">

                        <label asp-for="HostelId"
                               class="form-label-custom">

                            Hostel

                        </label>


                        <select asp-for="HostelId"
                                class="form-select menu-input"
                                asp-items="@(new SelectList(ViewBag.Hostels, "HostelId", "Name"))">

                            <option value="">
                                Select hostel
                            </option>

                        </select>


                        <span asp-validation-for="HostelId"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="MenuDate"
                               class="form-label-custom">

                            Menu Date

                        </label>


                        <input asp-for="MenuDate"
                               class="form-control menu-input" />


                        <span asp-validation-for="MenuDate"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- MEALS -->
                <div class="row g-4">

                    <!-- BREAKFAST -->
                    <div class="col-lg-4">

                        <div class="meal-section">

                            <div class="meal-section-header">

                                <h5>Breakfast</h5>


                                <div class="form-check form-switch meal-toggle">

                                    <input asp-for="IsBreakfastAvailable"
                                           class="form-check-input" />

                                    <label asp-for="IsBreakfastAvailable"
                                           class="form-check-label">

                                        Available

                                    </label>

                                </div>

                            </div>


                            <label asp-for="BreakfastItemsText"
                                   class="form-label-custom">

                                Breakfast Items

                            </label>


                            <textarea asp-for="BreakfastItemsText"
                                      class="form-control meal-textarea"
                                      placeholder="Example:
Poha
Tea
Banana"></textarea>


                            <div class="meal-help">
                                Enter meal items as required by your existing format.
                            </div>

                        </div>

                    </div>


                    <!-- LUNCH -->
                    <div class="col-lg-4">

                        <div class="meal-section">

                            <div class="meal-section-header">

                                <h5>Lunch</h5>


                                <div class="form-check form-switch meal-toggle">

                                    <input asp-for="IsLunchAvailable"
                                           class="form-check-input" />

                                    <label asp-for="IsLunchAvailable"
                                           class="form-check-label">

                                        Available

                                    </label>

                                </div>

                            </div>


                            <label asp-for="LunchItemsText"
                                   class="form-label-custom">

                                Lunch Items

                            </label>


                            <textarea asp-for="LunchItemsText"
                                      class="form-control meal-textarea"
                                      placeholder="Example:
Dal
Rice
Sabzi
Roti"></textarea>


                            <div class="meal-help">
                                Add all lunch items for the selected date.
                            </div>

                        </div>

                    </div>


                    <!-- DINNER -->
                    <div class="col-lg-4">

                        <div class="meal-section">

                            <div class="meal-section-header">

                                <h5>Dinner</h5>


                                <div class="form-check form-switch meal-toggle">

                                    <input asp-for="IsDinnerAvailable"
                                           class="form-check-input" />

                                    <label asp-for="IsDinnerAvailable"
                                           class="form-check-label">

                                        Available

                                    </label>

                                </div>

                            </div>


                            <label asp-for="DinnerItemsText"
                                   class="form-label-custom">

                                Dinner Items

                            </label>


                            <textarea asp-for="DinnerItemsText"
                                      class="form-control meal-textarea"
                                      placeholder="Example:
Paneer
Roti
Rice
Salad"></textarea>


                            <div class="meal-help">
                                Add all dinner items for the selected date.
                            </div>

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Create Menu

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}