@model List<Hostel_hub.Models.Hostel>

@{
    ViewData["Title"] = "Manage Hostels";

    int totalHostels = Model.Count;

    int totalRooms =
        Model.Sum(h => h.Rooms?.Count ?? 0);
}

<style>

    .hostels-page {
        padding: 35px 0 60px;
    }

    .hostels-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .hostels-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .hostels-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .create-hostel-btn {
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }


    /* ===========================
       SUMMARY
       =========================== */

    .summary-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        height: 100%;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.82rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }


    /* ===========================
       DIRECTORY
       =========================== */

    .directory-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-top: 26px;
    }

    .directory-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .directory-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 3px;
    }


    /* ===========================
       TABLE
       =========================== */

    .hostel-table {
        margin-bottom: 0;
    }

    .hostel-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
    }

    .hostel-table tbody td {
        padding: 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }


    /* ===========================
       HOSTEL
       =========================== */

    .hostel-name {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hostel-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .hostel-title {
        color: #172033;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .hostel-id {
        color: #8a94a3;
        font-size: 0.78rem;
    }


    /* ===========================
       BADGES
       =========================== */

    .type-badge {
        display: inline-block;
        background: #eef4ff;
        color: #0d6efd;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .rooms-badge {
        display: inline-block;
        background: #d1e7dd;
        color: #146c43;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }


    /* ===========================
       ACTION BUTTONS
       =========================== */

    .hostel-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
    }

    .hostel-actions .btn {
        border-radius: 7px;
        font-weight: 600;
    }


    /* ===========================
       EMPTY STATE
       =========================== */

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-weight: 700;
    }

    .empty-state h5 {
        color: #172033;
        font-weight: 700;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 20px;
    }


    /* ===========================
       RESPONSIVE
       =========================== */

    @@media (max-width: 767px) {

        .hostels-page {
            padding-top: 20px;
        }

        .hostels-header h2 {
            font-size: 1.7rem;
        }

        .hostels-header {
            align-items: stretch;
        }

        .hostels-header .d-flex {
            width: 100%;
        }

        .hostels-header .btn {
            flex: 1;
        }

    }

</style>


<div class="hostels-page">


    <!-- ==========================================
         HEADER
         ========================================== -->

    <div class="hostels-header">

        <div>

            <h2>
                Manage Hostels
            </h2>

            <p>
                Manage hostel buildings and their room structure.
            </p>

        </div>


        <!-- HEADER ACTIONS -->

        <div class="d-flex gap-2 flex-wrap">


            <!-- ALL HOSTELS OVERVIEW -->

            <a asp-controller="Admin"
               asp-action="AllHostelsOverview"
               class="btn btn-outline-primary create-hostel-btn">

                All Hostels Overview

            </a>


            <!-- CREATE HOSTEL -->

            <a asp-action="Create"
               class="btn btn-primary create-hostel-btn">

                + Create Hostel

            </a>

        </div>

    </div>



    <!-- ==========================================
         ERROR MESSAGE
         ========================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">

            @TempData["ErrorMessage"]

        </div>
    }



    <!-- ==========================================
         SUMMARY
         ========================================== -->

    <div class="row g-3">


        <!-- TOTAL HOSTELS -->

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Total Hostels
                </div>

                <p class="summary-number">

                    @totalHostels

                </p>

            </div>

        </div>



        <!-- TOTAL ROOMS -->

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Total Rooms
                </div>

                <p class="summary-number text-primary">

                    @totalRooms

                </p>

            </div>

        </div>



        <!-- AVERAGE ROOMS -->

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Average Rooms / Hostel
                </div>

                <p class="summary-number text-success">

                    @(
                        totalHostels > 0
                            ? Math.Round(
                                (double)totalRooms / totalHostels,
                                1
                            )
                            : 0
                    )

                </p>

            </div>

        </div>

    </div>



    <!-- ==========================================
         HOSTEL DIRECTORY
         ========================================== -->

    <div class="directory-card">


        <div class="directory-header">

            <h5>
                Hostel Directory
            </h5>

            <span class="text-muted small">

                @totalHostels hostel(s) registered in the system

            </span>

        </div>



        <!-- ======================================
             EMPTY STATE
             ====================================== -->

        @if (!Model.Any())
        {

            <div class="empty-state">

                <div class="empty-icon">
                    HH
                </div>


                <h5>
                    No hostels found
                </h5>


                <p>

                    Create your first hostel to begin managing
                    rooms and Warden assignments.

                </p>


                <a asp-action="Create"
                   class="btn btn-primary">

                    Create First Hostel

                </a>

            </div>

        }

        else
        {

            <!-- ==================================
                 HOSTEL TABLE
                 ================================== -->

            <div class="table-responsive">

                <table class="table table-hover hostel-table">


                    <thead>

                        <tr>

                            <th>
                                Hostel
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Total Rooms
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>



                    <tbody>

                        @foreach (var hostel in Model)
                        {

                            <tr>


                                <!-- =========================
                                     HOSTEL
                                     ========================= -->

                                <td>

                                    <div class="hostel-name">


                                        <div class="hostel-icon">

                                            HH

                                        </div>


                                        <div>

                                            <div class="hostel-title">

                                                @hostel.Name

                                            </div>


                                            <div class="hostel-id">

                                                Hostel ID:
                                                @hostel.HostelId

                                            </div>

                                        </div>

                                    </div>

                                </td>



                                <!-- =========================
                                     TYPE
                                     ========================= -->

                                <td>

                                    <span class="type-badge">

                                        @hostel.Type

                                    </span>

                                </td>



                                <!-- =========================
                                     ROOMS
                                     ========================= -->

                                <td>

                                    <span class="rooms-badge">

                                        @(hostel.Rooms?.Count ?? 0)
                                        Rooms

                                    </span>

                                </td>



                                <!-- =========================
                                     ACTIONS
                                     ========================= -->

                                <td>

                                    <div class="hostel-actions">


                                        <!-- VIEW -->

                                        <a asp-action="Details"
                                           asp-route-id="@hostel.HostelId"
                                           class="btn btn-outline-secondary btn-sm">

                                            View

                                        </a>



                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@hostel.HostelId"
                                           class="btn btn-outline-primary btn-sm">

                                            Edit

                                        </a>



                                        <!-- DELETE -->

                                        <form asp-action="Delete"
                                              asp-route-id="@hostel.HostelId"
                                              method="post"
                                              class="d-inline">


                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Delete this hostel?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</div>