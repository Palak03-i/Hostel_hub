@model Hostel_hub.ViewModels.CreateHostelWithWardenViewModel

@{
    ViewData["Title"] = "Create Hostel";
}

<style>
    .create-hostel-page {
        padding: 35px 0 60px;
    }

    .create-hostel-header {
        margin-bottom: 28px;
    }

    .create-hostel-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .create-hostel-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .hostel-form-card {
        max-width: 950px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .hostel-form-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .hostel-form-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .hostel-form-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .hostel-form-body {
        padding: 28px;
    }

    .section-card {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 24px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .section-title h5 {
        margin-bottom: 2px;
        font-weight: 700;
        color: #172033;
    }

    .section-title p {
        margin-bottom: 0;
        color: #7b8494;
        font-size: 0.84rem;
    }

    .form-label-custom {
        display: block;
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .hostel-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .hostel-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.12);
    }

    .warden-info {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 20px;
        color: #556274;
        font-size: 0.88rem;
    }

    .security-note {
        background: #fff8e1;
        border: 1px solid #ffe69c;
        border-radius: 10px;
        padding: 14px 16px;
        margin-top: 16px;
        color: #665c3b;
        font-size: 0.84rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 150px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {
        .create-hostel-page {
            padding-top: 20px;
        }

        .create-hostel-header h2 {
            font-size: 1.7rem;
        }

        .hostel-form-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<div class="create-hostel-page">

    <!-- PAGE HEADER -->
    <div class="create-hostel-header">

        <h2>Create Hostel and Warden</h2>

        <p>
            Register a new hostel and create its Warden account.
        </p>

    </div>


    <div class="hostel-form-card">

        <!-- CARD HEADER -->
        <div class="hostel-form-header">

            <h5>New Hostel Setup</h5>

            <p>
                Complete the hostel information and assign its Warden login.
            </p>

        </div>


        <div class="hostel-form-body">

            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- ============================
                     HOSTEL DETAILS
                     ============================ -->
                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">
                            H
                        </div>

                        <div>

                            <h5>Hostel Details</h5>

                            <p>
                                Basic information about the hostel.
                            </p>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- HOSTEL NAME -->
                        <div class="col-md-6">

                            <label asp-for="HostelName"
                                   class="form-label-custom">

                                Hostel Name

                            </label>


                            <input asp-for="HostelName"
                                   class="form-control hostel-input"
                                   placeholder="Example: Arav Hostel" />


                            <span asp-validation-for="HostelName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- HOSTEL TYPE -->
                        <div class="col-md-6">

                            <label asp-for="HostelType"
                                   class="form-label-custom">

                                Hostel Type

                            </label>


                            <select asp-for="HostelType"
                                    asp-items="Html.GetEnumSelectList<Hostel_hub.Models.HostelType>()"
                                    class="form-select hostel-input">

                                <option value="">
                                    Select hostel type
                                </option>

                            </select>


                            <span asp-validation-for="HostelType"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ============================
                     WARDEN ACCOUNT
                     ============================ -->
                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">
                            W
                        </div>

                        <div>

                            <h5>Warden Account</h5>

                            <p>
                                Create the login account for this hostel's Warden.
                            </p>

                        </div>

                    </div>


                    <div class="warden-info">
                        The Warden account created here will automatically
                        be associated with this hostel and will manage only
                        its operational data.
                    </div>


                    <div class="row g-4">

                        <!-- FULL NAME -->
                        <div class="col-md-6">

                            <label asp-for="WardenFullName"
                                   class="form-label-custom">

                                Warden Full Name

                            </label>


                            <input asp-for="WardenFullName"
                                   class="form-control hostel-input"
                                   placeholder="Enter Warden name" />


                            <span asp-validation-for="WardenFullName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- EMAIL -->
                        <div class="col-md-6">

                            <label asp-for="WardenEmail"
                                   class="form-label-custom">

                                Warden Email

                            </label>


                            <input asp-for="WardenEmail"
                                   class="form-control hostel-input"
                                   placeholder="warden@example.com" />


                            <span asp-validation-for="WardenEmail"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PASSWORD -->
                        <div class="col-md-6">

                            <label asp-for="Password"
                                   class="form-label-custom">

                                Password

                            </label>

                            <div class="input-group">
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control hostel-input"
                                       placeholder="Enter password" />
                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle-btn"
                                        data-password-toggle
                                        aria-label="Show password"
                                        title="Show password">
                                    <span class="password-toggle-icon" aria-hidden="true">
                                        <svg class="eye-icon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                        </svg>
                                    </span>
                                    <span class="password-toggle-text">Show</span>
                                </button>
                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- CONFIRM PASSWORD -->
                        <div class="col-md-6">

                            <label asp-for="ConfirmPassword"
                                   class="form-label-custom">

                                Confirm Password

                            </label>

                            <div class="input-group">
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control hostel-input"
                                       placeholder="Re-enter password" />
                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle-btn"
                                        data-password-toggle
                                        aria-label="Show password"
                                        title="Show password">
                                    <span class="password-toggle-icon" aria-hidden="true">
                                        <svg class="eye-icon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                        </svg>
                                    </span>
                                    <span class="password-toggle-text">Show</span>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <div class="security-note">
                        Use a strong password and share the credentials
                        securely with the assigned Warden.
                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Create Hostel and Warden

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}