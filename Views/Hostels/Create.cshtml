@model Hostel_hub.ViewModels.CreateHostelWithWardenViewModel

<h2>Create Hostel and Warden</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <h4>Hostel Details</h4>

    <div class="form-group mb-3">
        <label asp-for="HostelName"></label>
        <input asp-for="HostelName" class="form-control" />
        <span asp-validation-for="HostelName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="HostelType"></label>
        <select asp-for="HostelType"
                asp-items="Html.GetEnumSelectList<Hostel_hub.Models.HostelType>()"
                class="form-control">
            <option value="">-- Select Type --</option>
        </select>
        <span asp-validation-for="HostelType" class="text-danger"></span>
    </div>

    <hr />

    <h4>Warden Account</h4>

    <div class="form-group mb-3">
        <label asp-for="WardenFullName"></label>
        <input asp-for="WardenFullName" class="form-control" />
        <span asp-validation-for="WardenFullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="WardenEmail"></label>
        <input asp-for="WardenEmail" class="form-control" />
        <span asp-validation-for="WardenEmail" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Hostel and Warden
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>