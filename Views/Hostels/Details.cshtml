@model Hostel_hub.Models.Hostel

@{
    ViewData["Title"] = "Hostel Details";

    int totalRooms = Model.Rooms?.Count ?? 0;
}

<style>
    .hostel-details-page {
        padding: 35px 0 60px;
    }

    .hostel-details-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .hostel-details-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .hostel-details-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .hostel-id-badge {
        background: #eaf2ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .hostel-hero-card {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 10px 28px rgba(13,110,253,0.18);
        margin-bottom: 26px;
    }

    .hero-label {
        color: rgba(255,255,255,0.72);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .hero-name {
        font-size: 1.8rem;
        font-weight: 700;
        margin-top: 5px;
        margin-bottom: 22px;
    }

    .hero-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .hero-info-box {
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 12px;
        padding: 16px;
    }

    .hero-info-title {
        color: rgba(255,255,255,0.72);
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .hero-info-value {
        font-size: 1.25rem;
        font-weight: 700;
    }

    .details-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .details-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .details-card-header h5 {
        color: #172033;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .details-card-body {
        padding: 24px;
    }

    .detail-item {
        padding: 16px 0;
        border-bottom: 1px solid #edf0f5;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #8a94a3;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #172033;
        font-size: 1rem;
        font-weight: 600;
    }

    .type-badge {
        display: inline-block;
        background: #eef4ff;
        color: #0d6efd;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .rooms-badge {
        display: inline-block;
        background: #d1e7dd;
        color: #146c43;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .page-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
    }

    .page-actions .btn {
        min-width: 120px;
        padding: 9px 16px;
        border-radius: 9px;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .hostel-details-page {
            padding-top: 20px;
        }

        .hostel-details-header h2 {
            font-size: 1.7rem;
        }

        .hero-info-grid {
            grid-template-columns: 1fr;
        }

        .page-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .page-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="hostel-details-page">

    <!-- HEADER -->
    <div class="hostel-details-header">

        <div>
            <h2>Hostel Details</h2>

            <p>
                Review hostel information and room capacity.
            </p>
        </div>

        <span class="hostel-id-badge">
            Hostel ID: @Model.HostelId
        </span>

    </div>


    <!-- HOSTEL SUMMARY -->
    <div class="hostel-hero-card">

        <div class="hero-label">
            Hostel
        </div>

        <div class="hero-name">
            @Model.Name
        </div>


        <div class="hero-info-grid">

            <div class="hero-info-box">

                <div class="hero-info-title">
                    Hostel Type
                </div>

                <div class="hero-info-value">
                    @Model.Type
                </div>

            </div>


            <div class="hero-info-box">

                <div class="hero-info-title">
                    Total Rooms
                </div>

                <div class="hero-info-value">
                    @totalRooms
                </div>

            </div>

        </div>

    </div>


    <!-- DETAILS -->
    <div class="details-card">

        <div class="details-card-header">

            <h5>Hostel Information</h5>

            <span class="text-muted small">
                Basic configuration of this hostel
            </span>

        </div>


        <div class="details-card-body">

            <div class="detail-item">

                <div class="detail-label">
                    Hostel Name
                </div>

                <div class="detail-value">
                    @Model.Name
                </div>

            </div>


            <div class="detail-item">

                <div class="detail-label">
                    Hostel Type
                </div>

                <div class="detail-value">

                    <span class="type-badge">
                        @Model.Type
                    </span>

                </div>

            </div>


            <div class="detail-item">

                <div class="detail-label">
                    Total Rooms
                </div>

                <div class="detail-value">

                    <span class="rooms-badge">
                        @totalRooms Rooms
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ACTIONS -->
    <div class="page-actions">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            ← Back to Hostels

        </a>


        <a asp-action="Edit"
           asp-route-id="@Model.HostelId"
           class="btn btn-primary">

            Edit Hostel

        </a>

    </div>

</div>