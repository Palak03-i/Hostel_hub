@model ErrorViewModel

@{
    ViewData["Title"] = Model.Title;
}

<style>
    .error-page-container {
        padding: 60px 15px 80px;
        min-height: calc(100vh - 220px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .error-card {
        max-width: 620px;
        width: 100%;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
        padding: 48px 40px;
        text-align: center;
        border: 1px solid #edf0f5;
    }

    .error-status-badge {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .status-badge-500 {
        background: #fdf2f2;
        color: #dc3545;
        border: 1px solid #f8d7da;
    }

    .status-badge-404 {
        background: #f0f7ff;
        color: #0d6efd;
        border: 1px solid #cfe2ff;
    }

    .status-badge-403 {
        background: #fff8eb;
        color: #d97706;
        border: 1px solid #ffeeba;
    }

    .error-icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 2.2rem;
    }

    .icon-circle-500 {
        background: #fef2f2;
        color: #dc3545;
    }

    .icon-circle-404 {
        background: #eff6ff;
        color: #0d6efd;
    }

    .icon-circle-403 {
        background: #fffbeb;
        color: #d97706;
    }

    .error-title {
        font-size: 2rem;
        font-weight: 750;
        color: #172033;
        margin-bottom: 12px;
    }

    .error-message {
        color: #6c757d;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .btn-error-home {
        padding: 11px 26px;
        border-radius: 10px;
        font-weight: 600;
        background: #0d6efd;
        border-color: #0d6efd;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-error-home:hover {
        background: #0b5ed7;
        border-color: #0a58ca;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-error-back {
        padding: 11px 22px;
        border-radius: 10px;
        font-weight: 600;
    }

    .error-tracking {
        font-size: 0.82rem;
        color: #94a3b8;
        border-top: 1px solid #f1f5f9;
        padding-top: 18px;
        margin-bottom: 0;
    }

    .error-tracking code {
        color: #64748b;
        background: #f8fafc;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.8rem;
    }
</style>

<div class="error-page-container">
    <div class="error-card">
        @{
            string badgeClass = Model.StatusCode == 404 ? "status-badge-404"
                              : Model.StatusCode == 403 ? "status-badge-403"
                              : "status-badge-500";

            string circleClass = Model.StatusCode == 404 ? "icon-circle-404"
                               : Model.StatusCode == 403 ? "icon-circle-403"
                               : "icon-circle-500";

            string iconSymbol = Model.StatusCode == 404 ? "🔍"
                              : Model.StatusCode == 403 ? "🔒"
                              : "⚠️";
        }

        <div class="error-status-badge @badgeClass">
            Error @Model.StatusCode
        </div>

        <div class="error-icon-circle @circleClass">
            @iconSymbol
        </div>

        <h1 class="error-title">
            @Model.Title
        </h1>

        <p class="error-message">
            @Model.Message
        </p>

        <div class="error-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-error-home">
                &larr; Back to Home
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-error-back">
                Previous Page
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="error-tracking">
                Incident Reference ID: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>
