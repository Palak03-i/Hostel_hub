@model Hostel_hub.ViewModels.ComplaintEditViewModel

@{
    ViewData["Title"] = "Edit Complaint";
}

<style>
    .complaint-form-page {
        padding: 35px 0 60px;
    }

    .complaint-form-header {
        margin-bottom: 28px;
    }

    .complaint-form-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .complaint-form-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .complaint-form-card {
        max-width: 850px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .complaint-form-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f5;
        background: #fbfcfe;
    }

    .complaint-form-card-header h5 {
        margin-bottom: 4px;
        font-weight: 700;
        color: #172033;
    }

    .complaint-form-card-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .complaint-form-body {
        padding: 28px;
    }

    .form-section {
        margin-bottom: 22px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .complaint-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .complaint-textarea {
        min-height: 150px;
        resize: vertical;
    }

    .complaint-input:focus,
    .complaint-textarea:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .form-help {
        margin-top: 6px;
        font-size: 0.82rem;
        color: #8a94a3;
    }

    .complaint-info-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #49566a;
        font-size: 0.9rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 120px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {
        .complaint-form-page {
            padding-top: 20px;
        }

        .complaint-form-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="complaint-form-page">

    <!-- PAGE HEADER -->
    <div class="complaint-form-header">
        <h2>Edit Complaint</h2>
        <p>Update your complaint details before it is assigned for maintenance.</p>
    </div>

    <div class="complaint-form-card">

        <!-- CARD HEADER -->
        <div class="complaint-form-card-header">
            <h5>Complaint Details</h5>
            <p>Modify the information below. Only pending complaints can be updated.</p>
        </div>

        <!-- FORM BODY -->
        <div class="complaint-form-body">

            <div class="complaint-info-box">
                You can edit your complaint's title, category, and description as long as its status is Pending. Once assigned to maintenance staff, complaints cannot be edited.
            </div>

            <form asp-action="EditComplaint"
                  asp-route-id="@Model.ComplaintId"
                  method="post">

                <input type="hidden" asp-for="ComplaintId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- TITLE -->
                <div class="form-section">
                    <label asp-for="Title"
                           class="form-label-custom">
                        Complaint Title
                    </label>

                    <input asp-for="Title"
                           class="form-control complaint-input"
                           placeholder="Example: Water leakage in bathroom" />

                    <div class="form-help">
                        Enter a short title that clearly describes the issue (maximum 150 characters).
                    </div>

                    <span asp-validation-for="Title"
                          class="text-danger small">
                    </span>
                </div>

                <!-- CATEGORY -->
                <div class="form-section">
                    <label asp-for="Category"
                           class="form-label-custom">
                        Complaint Category
                    </label>

                    <select asp-for="Category"
                            asp-items="Html.GetEnumSelectList<Hostel_hub.Models.ComplaintCategory>()"
                            class="form-select complaint-input">
                        <option value="">
                            Select complaint category
                        </option>
                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger small">
                    </span>
                </div>

                <!-- DESCRIPTION -->
                <div class="form-section">
                    <label asp-for="Description"
                           class="form-label-custom">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control complaint-textarea"
                              placeholder="Describe the issue in detail..."></textarea>

                    <div class="form-help">
                        Mention the exact issue and any useful details for maintenance staff (maximum 1000 characters).
                    </div>

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>
                </div>

                <!-- ACTIONS -->
                <div class="form-actions">
                    <a asp-action="ComplaintDetails"
                       asp-route-id="@Model.ComplaintId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
