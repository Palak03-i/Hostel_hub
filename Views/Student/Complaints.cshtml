@using Hostel_hub.ViewModels
@model List<Hostel_hub.Models.Complaint>

@{
    ViewData["Title"] = "My Complaints";
    var filter = (ComplaintFilterViewModel?)ViewBag.Filter ?? new ComplaintFilterViewModel();
}

<style>
    .complaints-page {
        padding: 35px 0 60px;
    }

    .complaints-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .complaints-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .complaints-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .new-complaint-btn {
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .complaints-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.06);
        margin-top: 26px;
    }

    .complaints-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .complaints-card-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .complaints-table {
        margin-bottom: 0;
    }

    .complaints-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #edf0f5;
        padding: 15px 18px;
    }

    .complaints-table tbody td {
        padding: 17px 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }

    .complaint-title {
        font-weight: 600;
        color: #273142;
    }

    .status-badge,
    .priority-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .status-pending {
        background: #fff3cd;
        color: #997404;
    }

    .status-assigned {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .status-progress {
        background: #cff4fc;
        color: #087990;
    }

    .status-resolved {
        background: #d1e7dd;
        color: #146c43;
    }

    .status-default {
        background: #eceff3;
        color: #495057;
    }

    .priority-high {
        background: #f8d7da;
        color: #b02a37;
    }

    .priority-medium {
        background: #fff3cd;
        color: #997404;
    }

    .priority-low {
        background: #d1e7dd;
        color: #146c43;
    }

    .view-btn {
        border-radius: 8px;
        font-weight: 600;
        padding: 6px 12px;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-state-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin: 0 auto 16px;
    }

    .empty-state h5 {
        font-weight: 700;
        color: #172033;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 20px;
    }

    .filter-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        padding: 24px;
        margin-top: 26px;
    }

    .filter-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 6px;
        display: block;
    }

    .filter-control {
        border-radius: 8px;
        border: 1px solid #ced4da;
        font-size: 0.9rem;
        padding: 8px 12px;
    }

    .filter-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    @@media (max-width: 767px) {
        .complaints-page {
            padding-top: 20px;
        }

        .complaints-header h2 {
            font-size: 1.7rem;
        }
    }
</style>


<div class="complaints-page">

    <!-- HEADER -->
    <div class="complaints-header">

        <div>

            <h2>My Complaints</h2>

            <p>
                Track maintenance and hostel-related complaints.
            </p>

        </div>


        <a asp-action="CreateComplaint"
           class="btn btn-primary new-complaint-btn">

            + Raise Complaint

        </a>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- SUMMARY -->
    <div class="row g-3">

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Total Complaints
                </div>

                <p class="summary-number">
                    @Model.Count
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Active Complaints
                </div>

                <p class="summary-number text-warning">

                    @Model.Count(c =>
                        c.Status.ToString() != "Resolved")

                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-label">
                    Resolved Complaints
                </div>

                <p class="summary-number text-success">

                    @Model.Count(c =>
                        c.Status.ToString() == "Resolved")

                </p>

            </div>

        </div>

    </div>


    <!-- SEARCH & FILTER -->
    <div class="filter-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0" style="color: #172033; font-size: 1.15rem;">
                Search &amp; Filter My Complaints
            </h5>
            @if (filter.HasActiveFilters)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                    Active Filters
                </span>
            }
        </div>

        @if (ViewBag.DateErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                @ViewBag.DateErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="get" asp-action="Complaints">
            <div class="row g-3">
                <!-- SEARCH -->
                <div class="col-lg-6 col-md-12">
                    <label class="filter-label">Search</label>
                    <input type="text"
                           name="Search"
                           value="@filter.Search"
                           class="form-control filter-control"
                           placeholder="Search by complaint ID, title or description..." />
                </div>

                <!-- STATUS -->
                <div class="col-lg-3 col-md-6">
                    <label class="filter-label">Status</label>
                    <select name="Status" class="form-select filter-control">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<Hostel_hub.Models.ComplaintStatus>())
                        {
                            <option value="@s" selected="@(filter.Status == s)">
                                @(s == Hostel_hub.Models.ComplaintStatus.InProgress ? "In Progress" : s.ToString())
                            </option>
                        }
                    </select>
                </div>

                <!-- CATEGORY -->
                <div class="col-lg-3 col-md-6">
                    <label class="filter-label">Category</label>
                    <select name="Category" class="form-select filter-control">
                        <option value="">All Categories</option>
                        @foreach (var c in Enum.GetValues<Hostel_hub.Models.ComplaintCategory>())
                        {
                            <option value="@c" selected="@(filter.Category == c)">
                                @c.ToString()
                            </option>
                        }
                    </select>
                </div>

                <!-- PRIORITY -->
                <div class="col-lg-4 col-md-6">
                    <label class="filter-label">Priority</label>
                    <select name="Priority" class="form-select filter-control">
                        <option value="">All Priorities</option>
                        @foreach (var p in Enum.GetValues<Hostel_hub.Models.ComplaintPriority>())
                        {
                            <option value="@p" selected="@(filter.Priority == p)">
                                @p.ToString()
                            </option>
                        }
                    </select>
                </div>

                <!-- FROM DATE -->
                <div class="col-lg-4 col-md-6">
                    <label class="filter-label">From Date</label>
                    <input type="date"
                           name="FromDate"
                           value="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                           class="form-control filter-control" />
                </div>

                <!-- TO DATE -->
                <div class="col-lg-4 col-md-6">
                    <label class="filter-label">To Date</label>
                    <input type="date"
                           name="ToDate"
                           value="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                           class="form-control filter-control" />
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="d-flex gap-2 justify-content-end mt-3 pt-3 border-top">
                @if (filter.HasActiveFilters)
                {
                    <a asp-action="Complaints" class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                }
                <button type="submit" class="btn btn-primary">
                    Search / Apply Filters
                </button>
            </div>
        </form>
    </div>


    <!-- COMPLAINT LIST -->
    <div class="complaints-card">

        <div class="complaints-card-header">

            <h5>
                Complaint History
            </h5>

            <span class="text-muted small">
                @Model.Count record(s)
            </span>

        </div>


        @if (Model.Count == 0)
        {

            <div class="empty-state">

                <div class="empty-state-circle">
                    ✓
                </div>

                <h5>No complaints yet</h5>

                <p>
                    You have not raised any hostel complaints.
                </p>

                <a asp-action="CreateComplaint"
                   class="btn btn-primary">

                    Raise Your First Complaint

                </a>

            </div>

        }
        else
        {

            <div class="table-responsive">

                <table class="table table-hover complaints-table">

                    <thead>

                        <tr>

                            <th>Complaint</th>

                            <th>Category</th>

                            <th>Priority</th>

                            <th>Status</th>

                            <th>Created</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var c in Model)
                        {

                            string statusClass =
                                c.Status.ToString() switch
                                {
                                    "Pending" => "status-pending",
                                    "Assigned" => "status-assigned",
                                    "InProgress" => "status-progress",
                                    "Resolved" => "status-resolved",
                                    _ => "status-default"
                                };


                            string priorityClass =
                                c.Priority.ToString() switch
                                {
                                    "High" => "priority-high",
                                    "Medium" => "priority-medium",
                                    "Low" => "priority-low",
                                    _ => "status-default"
                                };


                            <tr>

                                <!-- TITLE -->
                                <td>

                                    <span class="complaint-title">
                                        @c.Title
                                    </span>

                                </td>


                                <!-- CATEGORY -->
                                <td>

                                    @c.Category

                                </td>


                                <!-- PRIORITY -->
                                <td>

                                    <span class="priority-badge @priorityClass">

                                        @c.Priority

                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    <span class="status-badge @statusClass">

                                        @(c.Status.ToString() == "InProgress"
                                            ? "In Progress"
                                            : c.Status.ToString())

                                    </span>

                                </td>


                                <!-- CREATED -->
                                <td>
    <div>
        @(c.CreatedAt
            .ToLocalTime()
            .ToString("dd MMM yyyy"))
    </div>

    <small class="text-muted">
        @(c.CreatedAt
            .ToLocalTime()
            .ToString("hh:mm tt"))
    </small>
</td>


                                <!-- ACTION -->
                                <td class="text-end text-nowrap">

                                    <div class="d-inline-flex gap-2">

                                        <a asp-action="ComplaintDetails"
                                           asp-route-id="@c.ComplaintId"
                                           class="btn btn-outline-primary btn-sm view-btn">

                                            View Details

                                        </a>

                                        @if (c.Status == Hostel_hub.Models.ComplaintStatus.Pending)
                                        {
                                            <a asp-action="EditComplaint"
                                               asp-route-id="@c.ComplaintId"
                                               class="btn btn-outline-secondary btn-sm view-btn">

                                                Edit

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</div>