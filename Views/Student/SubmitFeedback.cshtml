@model Hostel_hub.ViewModels.FeedbackCreateViewModel

@{
    ViewData["Title"] = "Submit Feedback";
}

<style>
    .submit-feedback-page {
        padding: 35px 0 60px;
    }

    .submit-feedback-header {
        margin-bottom: 28px;
    }

    .submit-feedback-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .submit-feedback-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .feedback-form-card {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .feedback-form-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .feedback-form-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .feedback-form-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .feedback-form-body {
        padding: 28px;
    }

    .info-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #49566a;
        font-size: 0.9rem;
    }

    .form-section {
        margin-bottom: 22px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .feedback-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .feedback-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .comments-textarea {
        min-height: 140px;
        resize: vertical;
    }

    .form-help {
        margin-top: 6px;
        font-size: 0.82rem;
        color: #8a94a3;
    }

    .rating-guide {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .rating-item {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 0.8rem;
        color: #657084;
    }

    .rating-star {
        color: #ffc107;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {

        .submit-feedback-page {
            padding-top: 20px;
        }

        .feedback-form-body {
            padding: 22px;
        }

        .submit-feedback-header h2 {
            font-size: 1.7rem;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<div class="submit-feedback-page">

    <!-- PAGE HEADER -->
    <div class="submit-feedback-header">

        <h2>Submit Feedback</h2>

        <p>
            Share your experience and help improve hostel services.
        </p>

    </div>


    <div class="feedback-form-card">

        <!-- CARD HEADER -->
        <div class="feedback-form-header">

            <h5>
                Feedback Details
            </h5>

            <p>
                Your feedback helps the hostel administration improve services.
            </p>

        </div>


        <!-- BODY -->
        <div class="feedback-form-body">

            <div class="info-box">
                Select the feedback type, provide a rating from 1 to 5,
                and add any comments you would like to share.
            </div>


            <form asp-action="SubmitFeedback"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- SOURCE -->
                <div class="form-section">

                    <label asp-for="Source"
                           class="form-label-custom">

                        Feedback Type

                    </label>


                    <select asp-for="Source"
                            asp-items="Html.GetEnumSelectList<Hostel_hub.Models.FeedbackSource>()"
                            class="form-select feedback-input">
                    </select>


                    <div class="form-help">
                        Choose whether this feedback is general or related to a complaint.
                    </div>

                </div>


                <!-- RELATED COMPLAINT -->
                <div class="form-section">

                    <label asp-for="ComplaintId"
                           class="form-label-custom">

                        Related Complaint

                    </label>


                    <select asp-for="ComplaintId"
                            class="form-select feedback-input">

                        <option value="">
                            No related complaint
                        </option>


                        @foreach (
                            var c in
                            (List<Hostel_hub.Models.Complaint>)
                            ViewBag.ResolvedComplaints)
                        {

                            <option value="@c.ComplaintId">
                                @c.Title
                            </option>

                        }

                    </select>


                    <div class="form-help">
                        Select a resolved complaint only when your feedback is complaint-related.
                    </div>

                </div>


                <!-- RATING -->
                <div class="form-section">

                    <label asp-for="Rating"
                           class="form-label-custom">

                        Rating

                    </label>


                    <select asp-for="Rating"
                            class="form-select feedback-input">

                        <option value="">
                            Select a rating
                        </option>

                        <option value="1">
                            1 — Very Poor
                        </option>

                        <option value="2">
                            2 — Poor
                        </option>

                        <option value="3">
                            3 — Average
                        </option>

                        <option value="4">
                            4 — Good
                        </option>

                        <option value="5">
                            5 — Excellent
                        </option>

                    </select>


                    <span asp-validation-for="Rating"
                          class="text-danger small">
                    </span>


                    <div class="rating-guide">

                        <span class="rating-item">
                            <span class="rating-star">★</span>
                            1 Very Poor
                        </span>

                        <span class="rating-item">
                            <span class="rating-star">★★</span>
                            2 Poor
                        </span>

                        <span class="rating-item">
                            <span class="rating-star">★★★</span>
                            3 Average
                        </span>

                        <span class="rating-item">
                            <span class="rating-star">★★★★</span>
                            4 Good
                        </span>

                        <span class="rating-item">
                            <span class="rating-star">★★★★★</span>
                            5 Excellent
                        </span>

                    </div>

                </div>


                <!-- COMMENTS -->
                <div class="form-section">

                    <label asp-for="Comments"
                           class="form-label-custom">

                        Comments

                    </label>


                    <textarea asp-for="Comments"
                              class="form-control feedback-input comments-textarea"
                              placeholder="Tell us about your experience..."></textarea>


                    <div class="form-help">
                        Mention what worked well or what could be improved.
                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-action="Feedback"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Submit Feedback

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}