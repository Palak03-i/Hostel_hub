@model Hostel_hub.ViewModels.RoomChangeCreateViewModel

@{
    ViewData["Title"] = "Request Room Change";
}

<style>
    .room-request-page {
        padding: 35px 0 60px;
    }

    .room-request-header {
        margin-bottom: 28px;
    }

    .room-request-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .room-request-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .room-request-card {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .room-request-card-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .room-request-card-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .room-request-card-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .room-request-body {
        padding: 28px;
    }

    .info-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #49566a;
        font-size: 0.9rem;
    }

    .form-section {
        margin-bottom: 22px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .room-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .room-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .reason-textarea {
        min-height: 150px;
        resize: vertical;
    }

    .form-help {
        margin-top: 6px;
        font-size: 0.82rem;
        color: #8a94a3;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {
        .room-request-page {
            padding-top: 20px;
        }

        .room-request-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<div class="room-request-page">

    <div class="room-request-header">

        <h2>Request Room Change</h2>

        <p>
            Select another available room in your hostel and provide a reason.
        </p>

    </div>


    <div class="room-request-card">

        <div class="room-request-card-header">

            <h5>
                Room Change Details
            </h5>

            <p>
                Your request will be reviewed by the hostel warden.
            </p>

        </div>


        <div class="room-request-body">

            <div class="info-box">
                Only rooms available in your assigned hostel are shown.
                Approval depends on availability and the warden's decision.
            </div>


            <form asp-action="RequestRoomChange"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- REQUESTED ROOM -->
                <div class="form-section">

                    <label asp-for="RequestedRoomId"
                           class="form-label-custom">

                        Requested Room

                    </label>


                    <select asp-for="RequestedRoomId"
                            class="form-select room-input">

                        <option value="">
                            Select an available room
                        </option>


                        @foreach (
                            var room in
                            (List<Hostel_hub.Models.Room>)
                            ViewBag.AvailableRooms)
                        {

                            <option value="@room.RoomId">

                                @room.Hostel?.Name -
                                Room @room.RoomNumber
                                (@room.CurrentOccupancy/@room.Capacity occupied)

                            </option>

                        }

                    </select>


                    <div class="form-help">
                        Occupancy is shown so you can compare available rooms.
                    </div>


                    <span asp-validation-for="RequestedRoomId"
                          class="text-danger small">
                    </span>

                </div>


                <!-- REASON -->
                <div class="form-section">

                    <label asp-for="Reason"
                           class="form-label-custom">

                        Reason for Room Change

                    </label>


                    <textarea asp-for="Reason"
                              class="form-control room-input reason-textarea"
                              placeholder="Explain why you would like to change your room..."></textarea>


                    <div class="form-help">
                        Provide a clear reason so the warden can review your request.
                    </div>


                    <span asp-validation-for="Reason"
                          class="text-danger small">
                    </span>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-action="RoomChangeRequests"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Submit Request

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}