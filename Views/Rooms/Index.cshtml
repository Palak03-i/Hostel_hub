@model List<Hostel_hub.Models.Room>

@{
    ViewData["Title"] = "Manage Rooms";

    int totalRooms = Model.Count;

    int fullRooms =
        Model.Count(r => r.CurrentOccupancy >= r.Capacity);

    int availableRooms =
        Model.Count(r => r.CurrentOccupancy < r.Capacity);

    int totalCapacity =
        Model.Sum(r => r.Capacity);

    int totalOccupied =
        Model.Sum(r => r.CurrentOccupancy);
}

<style>
    .rooms-page {
        padding: 35px 0 60px;
    }

    .rooms-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .rooms-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .rooms-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .create-room-btn {
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .summary-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .rooms-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        margin-top: 26px;
    }

    .rooms-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rooms-card-header h5 {
        margin-bottom: 0;
        font-weight: 700;
        color: #172033;
    }

    .rooms-table {
        margin-bottom: 0;
    }

    .rooms-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
    }

    .rooms-table tbody td {
        padding: 17px 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }

    .room-number {
        font-weight: 700;
        color: #172033;
        font-size: 1rem;
    }

    .hostel-badge {
        display: inline-block;
        background: #eaf2ff;
        color: #0d6efd;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .status-available {
        background: #d1e7dd;
        color: #146c43;
    }

    .status-full {
        background: #f8d7da;
        color: #b02a37;
    }

    .occupancy-wrapper {
        min-width: 130px;
    }

    .occupancy-text {
        font-weight: 600;
        color: #394355;
        margin-bottom: 6px;
        font-size: 0.88rem;
    }

    .occupancy-bar {
        height: 7px;
        background: #edf0f5;
        border-radius: 20px;
        overflow: hidden;
    }

    .occupancy-fill {
        height: 100%;
        background: #0d6efd;
        border-radius: 20px;
    }

    .room-actions {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .room-actions .btn {
        border-radius: 7px;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-weight: 700;
    }

    .empty-state h5 {
        font-weight: 700;
        color: #172033;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 20px;
    }

    @@media (max-width: 767px) {
        .rooms-page {
            padding-top: 20px;
        }

        .rooms-header h2 {
            font-size: 1.7rem;
        }
    }
</style>


<div class="rooms-page">

    <!-- HEADER -->
    <div class="rooms-header">

        <div>
            <h2>Manage Rooms</h2>

            <p>
                Manage hostel rooms, capacity and current occupancy.
            </p>
        </div>


        <a asp-action="Create"
           class="btn btn-primary create-room-btn">

            + Create Room

        </a>

    </div>


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- SUMMARY -->
    <div class="row g-3">

        <div class="col-md-3">

            <div class="summary-card">

                <div class="summary-label">
                    Total Rooms
                </div>

                <p class="summary-number">
                    @totalRooms
                </p>

            </div>

        </div>


        <div class="col-md-3">

            <div class="summary-card">

                <div class="summary-label">
                    Available Rooms
                </div>

                <p class="summary-number text-success">
                    @availableRooms
                </p>

            </div>

        </div>


        <div class="col-md-3">

            <div class="summary-card">

                <div class="summary-label">
                    Full Rooms
                </div>

                <p class="summary-number text-danger">
                    @fullRooms
                </p>

            </div>

        </div>


        <div class="col-md-3">

            <div class="summary-card">

                <div class="summary-label">
                    Total Occupancy
                </div>

                <p class="summary-number">
                    @totalOccupied
                    <span class="fs-6 text-muted">
                        / @totalCapacity
                    </span>
                </p>

            </div>

        </div>

    </div>


    <!-- ROOM LIST -->
    <div class="rooms-card">

        <div class="rooms-card-header">

            <div>

                <h5>
                    Room Directory
                </h5>

                <span class="text-muted small">
                    @totalRooms room(s)
                </span>

            </div>

        </div>


        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    RM
                </div>

                <h5>No rooms available</h5>

                <p>
                    Create the first room for this hostel.
                </p>


                <a asp-action="Create"
                   class="btn btn-primary">

                    Create Room

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover rooms-table">

                    <thead>
                        <tr>
                            <th>Hostel</th>
                            <th>Room</th>
                            <th>Capacity</th>
                            <th>Occupancy</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var room in Model)
                        {
                            bool isFull =
                                room.CurrentOccupancy >= room.Capacity;

                            int occupancyPercentage =
                                room.Capacity > 0
                                    ? (int)(
                                        ((double)room.CurrentOccupancy
                                        / room.Capacity) * 100)
                                    : 0;


                            <tr>

                                <!-- HOSTEL -->
                                <td>

                                    <span class="hostel-badge">

                                        @(room.Hostel?.Name
                                            ?? "Not assigned")

                                    </span>

                                </td>


                                <!-- ROOM NUMBER -->
                                <td>

                                    <span class="room-number">
                                        Room @room.RoomNumber
                                    </span>

                                </td>


                                <!-- CAPACITY -->
                                <td>

                                    @room.Capacity

                                </td>


                                <!-- OCCUPANCY -->
                                <td>

                                    <div class="occupancy-wrapper">

                                        <div class="occupancy-text">

                                            @room.CurrentOccupancy
                                            / @room.Capacity occupied

                                        </div>


                                        <div class="occupancy-bar">

                                            <div class="occupancy-fill"
                                                 style="width: @occupancyPercentage%">
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    <span class="status-badge
                                                 @(isFull
                                                     ? "status-full"
                                                     : "status-available")">

                                        @(isFull
                                            ? "Full"
                                            : "Available")

                                    </span>

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="room-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@room.RoomId"
                                           class="btn btn-outline-secondary btn-sm">

                                            View

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@room.RoomId"
                                           class="btn btn-outline-primary btn-sm">

                                            Edit

                                        </a>


                                        <form asp-action="Delete"
                                              asp-route-id="@room.RoomId"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to delete this room?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>