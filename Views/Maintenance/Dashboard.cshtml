@model Hostel_hub.ViewModels.StaffDashboardViewModel

@{
    ViewData["Title"] = "Maintenance Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Welcome, @Model.FullName</h1>
        <p class="page-header-subtitle">
            Assigned complaints, priority work items &amp; resolution progress
        </p>
    </div>
    <div class="page-header-actions">
        <span class="role-pill">
            <span class="status-dot status-dot-assigned"></span>
            Maintenance Staff
        </span>
        <a asp-action="AssignedComplaints" class="btn btn-sm btn-primary">
            View Assigned Complaints
        </a>
    </div>
</div>

<!-- SPECIALIZATION BANNER -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body d-flex align-items-center justify-content-between p-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="kpi-icon-pill">
                🔧
            </div>
            <div>
                <small class="text-muted fw-semibold text-uppercase">Trade / Specialization</small>
                <div class="fs-5 fw-bold text-dark">
                    @Model.Specialization
                </div>
            </div>
        </div>
        <div>
            <span class="badge bg-light text-secondary border">
                Duty Active
            </span>
        </div>
    </div>
</div>

<!-- SUMMARY METRICS -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="summary-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="summary-label">Total Assigned</div>
                    <div class="summary-number">@Model.TotalAssigned</div>
                    <p class="kpi-subtext">All assigned tickets</p>
                </div>
                <div class="kpi-icon-pill">
                    📋
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="summary-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="summary-label">Pending Action</div>
                    <div class="summary-number text-warning">@Model.PendingCount</div>
                    <p class="kpi-subtext">Needs inspection</p>
                </div>
                <div class="kpi-icon-pill" style="background-color: var(--hh-warning-subtle); color: var(--hh-warning-text); border-color: var(--hh-warning-border);">
                    ⏳
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="summary-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="summary-label">In Progress</div>
                    <div class="summary-number text-info">@Model.InProgressCount</div>
                    <p class="kpi-subtext">Under repair</p>
                </div>
                <div class="kpi-icon-pill" style="background-color: var(--hh-info-subtle); color: var(--hh-info-text); border-color: var(--hh-info-border);">
                    ⚙️
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RECENTLY RESOLVED COMPLAINTS -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">Recently Resolved Tasks</h5>
            <small class="text-muted">Complaints completed and closed out</small>
        </div>
        <a asp-action="AssignedComplaints" class="btn btn-sm btn-outline-primary">
            View All Assigned
        </a>
    </div>

    <div class="card-body p-0">
        @if (!Model.RecentlyResolved.Any())
        {
            <div class="empty-state p-4">
                <p class="text-muted mb-0">No resolved complaints yet. Active jobs will appear here upon completion.</p>
            </div>
        }
        else
        {
            <div class="table-responsive border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Complaint Title</th>
                            <th>Resolved Timestamp</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var complaint in Model.RecentlyResolved)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark">@complaint.Title</strong>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @complaint.ResolvedDate?.ToString("dd MMM yyyy, hh:mm tt")
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge status-resolved">
                                        ✓ Resolved
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>