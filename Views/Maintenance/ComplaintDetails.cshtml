@model Hostel_hub.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details";

    var history =
        ViewBag.History as List<Hostel_hub.Models.ComplaintStatusHistory>
        ?? new List<Hostel_hub.Models.ComplaintStatusHistory>();

    string status = Model.Status.ToString();
}

<style>
    .maintenance-details-page {
        padding: 35px 0 60px;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .details-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .details-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .complaint-id {
        background: #eef4ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 25px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .details-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .details-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .details-card-header h5 {
        margin-bottom: 3px;
        color: #172033;
        font-weight: 700;
    }

    .details-card-body {
        padding: 24px;
    }

    .detail-label {
        color: #8a94a3;
        font-size: 0.76rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .description-box {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        padding: 18px;
        color: #465064;
        line-height: 1.65;
        min-height: 90px;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-assigned {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .status-progress {
        background: #cff4fc;
        color: #087990;
    }

    .status-resolved {
        background: #d1e7dd;
        color: #146c43;
    }

    .status-other {
        background: #eceff3;
        color: #6c757d;
    }

    .workflow-card {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: white;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 10px 28px rgba(13,110,253,0.16);
    }

    .workflow-card h5 {
        font-weight: 700;
        margin-bottom: 6px;
    }

    .workflow-card p {
        color: rgba(255,255,255,0.78);
        margin-bottom: 18px;
    }

    .workflow-steps {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .workflow-step {
        background: rgba(255,255,255,0.13);
        border: 1px solid rgba(255,255,255,0.18);
        padding: 9px 13px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .workflow-step-active {
        background: white;
        color: #0d6efd;
    }

    .workflow-arrow {
        color: rgba(255,255,255,0.65);
        font-weight: 700;
    }

    .action-btn {
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .completed-box {
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 10px;
        padding: 14px 16px;
        font-weight: 600;
    }

    .history-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .history-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .history-header h5 {
        margin-bottom: 3px;
        color: #172033;
        font-weight: 700;
    }

    .history-body {
        padding: 24px;
    }

    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 8px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: #e3e7ee;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 22px;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: -28px;
        top: 5px;
        width: 14px;
        height: 14px;
        background: #0d6efd;
        border: 3px solid #eaf2ff;
        border-radius: 50%;
    }

    .timeline-date {
        color: #8a94a3;
        font-size: 0.78rem;
        margin-bottom: 5px;
    }

    .timeline-status {
        color: #172033;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .timeline-user {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .empty-history {
        background: #f8f9fc;
        border-radius: 10px;
        padding: 18px;
        text-align: center;
        color: #6c757d;
    }

    .back-btn {
        margin-top: 26px;
        border-radius: 9px;
        padding: 9px 18px;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .maintenance-details-page {
            padding-top: 20px;
        }

        .details-header h2 {
            font-size: 1.7rem;
        }

        .workflow-arrow {
            display: none;
        }

        .workflow-steps {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>


<div class="maintenance-details-page">

    <!-- HEADER -->
    <div class="details-header">

        <div>

            <h2>@Model.Title</h2>

            <p>
                Review the maintenance complaint and update its work status.
            </p>

        </div>


        <span class="complaint-id">

            Complaint #@Model.ComplaintId

        </span>

    </div>


    <!-- ERROR -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- COMPLAINT DETAILS -->
    <div class="details-card">

        <div class="details-card-header">

            <h5>Complaint Information</h5>

            <span class="text-muted small">
                Maintenance task details
            </span>

        </div>


        <div class="details-card-body">

            <div class="row g-4">

                <!-- STATUS -->
                <div class="col-md-4">

                    <div class="detail-label">
                        Current Status
                    </div>


                    @if (status == "Assigned")
                    {
                        <span class="status-badge status-assigned">
                            Assigned
                        </span>
                    }
                    else if (
                        status == "InProgress" ||
                        status == "In Progress")
                    {
                        <span class="status-badge status-progress">
                            In Progress
                        </span>
                    }
                    else if (status == "Resolved")
                    {
                        <span class="status-badge status-resolved">
                            Resolved
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-other">
                            @Model.Status
                        </span>
                    }

                </div>


                <!-- DESCRIPTION -->
                <div class="col-md-8">

                    <div class="detail-label">
                        Description
                    </div>

                    <div class="description-box">

                        @Model.Description

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- WORKFLOW / STATUS ACTION -->
    <div class="workflow-card">

        <h5>Maintenance Workflow</h5>

        <p>
            Update the complaint as maintenance work progresses.
        </p>


        <div class="workflow-steps">

            <span class="workflow-step
                         @(Model.Status == Hostel_hub.Models.ComplaintStatus.Assigned
                             ? "workflow-step-active"
                             : "")">

                Assigned

            </span>


            <span class="workflow-arrow">
                →
            </span>


            <span class="workflow-step
                         @(Model.Status == Hostel_hub.Models.ComplaintStatus.InProgress
                             ? "workflow-step-active"
                             : "")">

                In Progress

            </span>


            <span class="workflow-arrow">
                →
            </span>


            <span class="workflow-step
                         @(Model.Status == Hostel_hub.Models.ComplaintStatus.Resolved
                             ? "workflow-step-active"
                             : "")">

                Resolved

            </span>

        </div>


        @if (Model.Status == Hostel_hub.Models.ComplaintStatus.Assigned)
        {
            <form asp-action="UpdateStatus"
                  method="post">

                <input type="hidden"
                       name="complaintId"
                       value="@Model.ComplaintId" />

                <input type="hidden"
                       name="newStatus"
                       value="InProgress" />


                <button type="submit"
                        class="btn btn-light action-btn">

                    Start Work — Mark In Progress

                </button>

            </form>
        }

        else if (Model.Status == Hostel_hub.Models.ComplaintStatus.InProgress)
        {
            <form asp-action="UpdateStatus"
                  method="post">

                <input type="hidden"
                       name="complaintId"
                       value="@Model.ComplaintId" />

                <input type="hidden"
                       name="newStatus"
                       value="Resolved" />


                <button type="submit"
                        class="btn btn-success action-btn"
                        onclick="return confirm('Mark this complaint as resolved?');">

                    Mark Complaint Resolved

                </button>

            </form>
        }

        else if (Model.Status == Hostel_hub.Models.ComplaintStatus.Resolved)
        {
            <div class="completed-box">

                ✓ This maintenance complaint has been resolved.

            </div>
        }

    </div>


    <!-- HISTORY -->
    <div class="history-card">

        <div class="history-header">

            <h5>Status History</h5>

            <span class="text-muted small">
                Complete complaint progress timeline
            </span>

        </div>


        <div class="history-body">

            @if (history.Any())
            {
                <div class="timeline">

                    @foreach (var h in history)
                    {
                        <div class="timeline-item">

                            <div class="timeline-dot">
                            </div>


                            <div class="timeline-date">

                                @(h.ChangedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt"))

                            </div>


                            <div class="timeline-status">

                                @h.OldStatus
                                →
                                @h.NewStatus

                            </div>


                            <div class="timeline-user">

                                Changed by @h.ChangedBy

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-history">

                    No status history is available for this complaint.

                </div>
            }

        </div>

    </div>


    <!-- BACK -->
    <a asp-action="AssignedComplaints"
       class="btn btn-outline-secondary back-btn">

        ← Back to My Complaints

    </a>

</div>