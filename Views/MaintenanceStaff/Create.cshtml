@model Hostel_hub.ViewModels.MaintenanceStaffCreateViewModel

@{
    ViewData["Title"] = "Add Maintenance Staff";
}

<style>
    .staff-create-page {
        padding: 35px 0 60px;
    }

    .staff-create-header {
        margin-bottom: 28px;
    }

    .staff-create-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .staff-create-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .staff-form-card {
        max-width: 900px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .staff-form-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .staff-form-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .staff-form-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .staff-form-body {
        padding: 28px;
    }

    .info-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #556274;
        font-size: 0.9rem;
    }

    .section-card {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 24px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .section-title h5 {
        margin-bottom: 2px;
        font-weight: 700;
        color: #172033;
    }

    .section-title p {
        margin-bottom: 0;
        color: #7b8494;
        font-size: 0.84rem;
    }

    .form-label-custom {
        display: block;
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .staff-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .staff-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.12);
    }

    .security-note {
        background: #fff8e1;
        border: 1px solid #ffe69c;
        border-radius: 10px;
        padding: 14px 16px;
        margin-top: 16px;
        color: #665c3b;
        font-size: 0.84rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {
        .staff-create-page {
            padding-top: 20px;
        }

        .staff-create-header h2 {
            font-size: 1.7rem;
        }

        .staff-form-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<div class="staff-create-page">

    <!-- PAGE HEADER -->
    <div class="staff-create-header">

        <h2>Add Maintenance Staff</h2>

        <p>
            Create a maintenance staff account for your hostel.
        </p>

    </div>


    <div class="staff-form-card">

        <!-- CARD HEADER -->
        <div class="staff-form-header">

            <h5>Staff Account Setup</h5>

            <p>
                Enter the staff member's login, contact and specialization details.
            </p>

        </div>


        <div class="staff-form-body">

            <div class="info-box">
                This maintenance staff account will be associated with your hostel
                and can receive maintenance complaints assigned by the Warden.
            </div>


            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- ==========================
                     ACCOUNT DETAILS
                     ========================== -->

                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">
                            A
                        </div>

                        <div>

                            <h5>Account Details</h5>

                            <p>
                                Login credentials used by the maintenance staff member.
                            </p>

                        </div>

                    </div>


                    <div class="row g-4">


                        <!-- EMAIL -->
                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label-custom">

                                Email Address

                            </label>


                            <input asp-for="Email"
                                   class="form-control staff-input"
                                   placeholder="staff@example.com" />


                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PASSWORD -->
                        <div class="col-md-6">

                            <label asp-for="Password"
                                   class="form-label-custom">

                                Password

                            </label>

                            <div class="input-group">
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control staff-input"
                                       placeholder="Enter password" />
                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle-btn"
                                        data-password-toggle
                                        aria-label="Show password"
                                        title="Show password">
                                    <span class="password-toggle-icon" aria-hidden="true">
                                        <svg class="eye-icon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                        </svg>
                                    </span>
                                    <span class="password-toggle-text">Show</span>
                                </button>
                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <div class="security-note">
                        Use a secure password and share the login credentials
                        only with the assigned staff member.
                    </div>

                </div>


                <!-- ==========================
                     PERSONAL DETAILS
                     ========================== -->

                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">
                            S
                        </div>

                        <div>

                            <h5>Staff Information</h5>

                            <p>
                                Personal and maintenance specialization details.
                            </p>

                        </div>

                    </div>


                    <div class="row g-4">


                        <!-- FULL NAME -->
                        <div class="col-md-6">

                            <label asp-for="FullName"
                                   class="form-label-custom">

                                Full Name

                            </label>


                            <input asp-for="FullName"
                                   class="form-control staff-input"
                                   placeholder="Enter staff member name" />


                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PHONE NUMBER -->
                        <div class="col-md-6">

                            <label asp-for="PhoneNumber"
                                   class="form-label-custom">

                                Phone Number

                            </label>


                            <input asp-for="PhoneNumber"
                                   class="form-control staff-input"
                                   placeholder="Enter contact number" />


                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- SPECIALIZATION -->
                        <div class="col-md-12">

                            <label asp-for="Specialization"
                                   class="form-label-custom">

                                Specialization

                            </label>


                            <select asp-for="Specialization"
                                    asp-items="Html.GetEnumSelectList<Hostel_hub.Models.StaffSpecialization>()"
                                    class="form-select staff-input">
                            </select>


                            <span asp-validation-for="Specialization"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Create Staff

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}