@model Hostel_hub.ViewModels.StaffManagementViewModel

@{
    ViewData["Title"] = "Manage Staff";

    string currentSearch =
        Context.Request.Query["search"].ToString();
    string currentStatus =
        Context.Request.Query["status"].ToString();
}

<style>
    .staff-page {
        padding: 35px 0 60px;
    }

    .staff-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .staff-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .staff-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .role-badge {
        background: #eaf2ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .add-staff-btn {
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        height: 100%;
    }

    .summary-label {
        color: #7c8798;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 0;
    }

    .staff-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-top: 26px;
    }

    .staff-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .staff-card-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 2px;
    }

    .staff-table {
        margin-bottom: 0;
    }

    .staff-table thead th {
        background: #f8f9fc;
        color: #657084;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
    }

    .staff-table tbody td {
        padding: 17px 18px;
        vertical-align: middle;
        border-color: #f0f2f5;
    }

    .staff-name {
        font-weight: 700;
        color: #273142;
    }

    .hostel-badge {
        display: inline-block;
        background: #eef4ff;
        color: #0d6efd;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .specialization-badge {
        display: inline-block;
        background: #f1f3f5;
        color: #495057;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .warden-badge {
        display: inline-block;
        background: #d1e7dd;
        color: #146c43;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .search-box {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .search-input {
        min-width: 260px;
        border-radius: 9px;
    }

    .search-btn {
        border-radius: 9px;
        font-weight: 600;
    }

    .edit-btn {
        border-radius: 8px;
        font-weight: 600;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-align: center;
    }

    .status-active {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }

    .status-inactive {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    .status-select {
        min-width: 140px;
        border-radius: 9px;
    }

    .empty-state {
        padding: 45px 20px;
        text-align: center;
        color: #6c757d;
    }

    @@media (max-width: 767px) {
        .staff-page {
            padding-top: 20px;
        }

        .staff-header h2 {
            font-size: 1.7rem;
        }

        .search-box,
        .search-input {
            width: 100%;
        }
    }
</style>


<div class="staff-page">

    <!-- HEADER -->
    <div class="staff-header">

        <div>

            <h2>Manage Staff</h2>

            <p>
                @(Model.IsSuperAdmin
                    ? "View Wardens and maintenance staff across all hostels."
                    : "Manage maintenance staff assigned to your hostel.")
            </p>

        </div>


        <div class="d-flex align-items-center gap-2 flex-wrap">

            <span class="role-badge">

                @(Model.IsSuperAdmin
                    ? "Super Admin"
                    : "Warden")

            </span>


            @if (!Model.IsSuperAdmin)
            {
                <a asp-action="Create"
                   class="btn btn-primary add-staff-btn">

                    + Add Maintenance Staff

                </a>
            }

        </div>

    </div>


    @if (TempData["StaffSuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["StaffSuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["StaffErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["StaffErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- SUMMARY -->
    <div class="row g-3">

        @if (Model.IsSuperAdmin)
        {
            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-label">
                        Total Wardens
                    </div>

                    <p class="summary-number">
                        @Model.Wardens.Count
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-label">
                        Active Staff
                    </div>

                    <p class="summary-number text-success">
                        @Model.MaintenanceStaff.Count(s => s.IsActive)
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-label">
                        Inactive Staff
                    </div>

                    <p class="summary-number text-muted">
                        @Model.MaintenanceStaff.Count(s => !s.IsActive)
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-label">
                        Total Staff
                    </div>

                    <p class="summary-number">
                        @Model.MaintenanceStaff.Count
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-label">
                        Active Staff
                    </div>

                    <p class="summary-number text-success">
                        @Model.MaintenanceStaff.Count(s => s.IsActive)
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-label">
                        Inactive Staff
                    </div>

                    <p class="summary-number text-muted">
                        @Model.MaintenanceStaff.Count(s => !s.IsActive)
                    </p>

                </div>

            </div>
        }

    </div>


    <!-- ================================
         WARDENS — SUPER ADMIN ONLY
         ================================ -->

    @if (Model.IsSuperAdmin)
    {
        <div class="staff-card">

            <div class="staff-card-header">

                <div>

                    <h5>Wardens</h5>

                    <span class="text-muted small">
                        Hostel administration staff
                    </span>

                </div>

            </div>


            @if (!Model.Wardens.Any())
            {
                <div class="empty-state">
                    No Wardens found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover staff-table">

                        <thead>

                            <tr>
                                <th>Warden</th>
                                <th>Email</th>
                                <th>Assigned Hostel</th>
                                <th>Status</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var warden in Model.Wardens)
                            {
                                <tr>

                                    <td>
                                        <span class="staff-name">
                                            @warden.FullName
                                        </span>
                                    </td>


                                    <td>
                                        @(warden.User?.Email ?? "N/A")
                                    </td>


                                    <td>

                                        @if (warden.Hostel != null)
                                        {
                                            <span class="hostel-badge">
                                                @warden.Hostel.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unassigned
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        <span class="warden-badge">
                                            Warden
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    }


    <!-- ================================
         MAINTENANCE STAFF
         ================================ -->

    <div class="staff-card">

        <div class="staff-card-header">

            <div>

                <h5>Maintenance Staff</h5>

                <span class="text-muted small">
                    @Model.MaintenanceStaff.Count staff member(s)
                </span>

            </div>


            <form method="get"
                  class="search-box">

                <input type="text"
                       name="search"
                       value="@currentSearch"
                       class="form-control search-input"
                       placeholder="Search by staff name" />

                <select name="status" class="form-select status-select">
                    <option value="" selected="@(string.IsNullOrEmpty(currentStatus))">All Status</option>
                    <option value="Active" selected="@(currentStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(currentStatus == "Inactive")">Inactive</option>
                </select>

                <button type="submit"
                        class="btn btn-primary search-btn">

                    Filter

                </button>


                @if (!string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentStatus))
                {
                    <a asp-action="Index"
                       class="btn btn-outline-secondary search-btn">

                        Clear

                    </a>
                }

            </form>

        </div>


        @if (!Model.MaintenanceStaff.Any())
        {
            <div class="empty-state">

                No maintenance staff found.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover staff-table">

                    <thead>

                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Specialization</th>
                            <th>Hostel</th>
                            <th>Status</th>

                            @if (!Model.IsSuperAdmin)
                            {
                                <th class="text-end">
                                    Action
                                </th>
                            }
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var staff in Model.MaintenanceStaff)
                        {
                            <tr>

                                <td>
                                    <span class="staff-name">
                                        @staff.FullName
                                    </span>
                                </td>


                                <td>
                                    @(staff.User?.Email ?? "N/A")
                                </td>


                                <td>
                                    @(staff.PhoneNumber ?? "N/A")
                                </td>


                                <td>

                                    <span class="specialization-badge">
                                        @staff.Specialization
                                    </span>

                                </td>


                                <td>

                                    @if (staff.Hostel != null)
                                    {
                                        <span class="hostel-badge">
                                            @staff.Hostel.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unassigned
                                        </span>
                                    }

                                </td>


                                <td>
                                    @if (staff.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>


                                @if (!Model.IsSuperAdmin)
                                {
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2 align-items-center">
                                            <a asp-action="Details"
                                               asp-route-id="@staff.MaintenanceStaffId"
                                               class="btn btn-outline-secondary btn-sm edit-btn">
                                                View
                                            </a>

                                            @if (staff.IsActive)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@staff.MaintenanceStaffId"
                                                   class="btn btn-outline-primary btn-sm edit-btn">
                                                    Edit
                                                </a>
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm edit-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deactivateModal-@staff.MaintenanceStaffId">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-success btn-sm edit-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#reactivateModal-@staff.MaintenanceStaffId">
                                                    Reactivate
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.IsSuperAdmin)
            {
                @foreach (var staff in Model.MaintenanceStaff)
                {
                    if (staff.IsActive)
                    {
                        <!-- Deactivate Confirmation Modal -->
                        <div class="modal fade" id="deactivateModal-@staff.MaintenanceStaffId" tabindex="-1" aria-labelledby="deactivateModalLabel-@staff.MaintenanceStaffId" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deactivateModalLabel-@staff.MaintenanceStaffId">Confirm Deactivation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <p class="mb-2">Are you sure you want to deactivate this maintenance staff member?</p>
                                        <p class="fw-bold mb-3 text-danger">@staff.FullName (@staff.Specialization)</p>
                                        <div class="alert alert-warning py-2 mb-0 small">
                                            The staff member record will be preserved. Historical complaints will remain intact, but this staff member will no longer receive new assignments or be able to log in.
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="Deactivate" asp-route-id="@staff.MaintenanceStaffId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">Deactivate</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Reactivate Confirmation Modal -->
                        <div class="modal fade" id="reactivateModal-@staff.MaintenanceStaffId" tabindex="-1" aria-labelledby="reactivateModalLabel-@staff.MaintenanceStaffId" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="reactivateModalLabel-@staff.MaintenanceStaffId">Confirm Reactivation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <p class="mb-2">Reactivate this maintenance staff member?</p>
                                        <p class="fw-bold mb-3 text-success">@staff.FullName (@staff.Specialization)</p>
                                        <div class="alert alert-info py-2 mb-0 small">
                                            This staff member will become Active, regain login access, and be available for new complaint assignments.
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="Reactivate" asp-route-id="@staff.MaintenanceStaffId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success">Reactivate</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        }

    </div>

</div>