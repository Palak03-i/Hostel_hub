@model List<Hostel_hub.Models.MaintenanceStaff>

<h2>Manage Maintenance Staff</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Staff</a>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" class="form-control w-auto" placeholder="Search by name" />
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

@if (!Model.Any())
{
    <p>No staff found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Specialization</th>
                <th>Hostel</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var staff in Model)
            {
                <tr>
                    <td>@staff.FullName</td>
                    <td>@staff.User?.Email</td>
                    <td>@staff.PhoneNumber</td>
                    <td>@staff.Specialization</td>
                    <td>@(staff.Hostel?.Name ?? "Unassigned")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@staff.MaintenanceStaffId" class="btn btn-sm btn-primary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}