@model Hostel_hub.ViewModels.MaintenanceStaffEditViewModel

@{
    ViewData["Title"] = "Edit Maintenance Staff";
}

<style>
    .staff-edit-page {
        padding: 35px 0 60px;
    }

    .staff-edit-header {
        margin-bottom: 28px;
    }

    .staff-edit-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .staff-edit-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .staff-form-card {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .staff-form-header {
        padding: 22px 26px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf0f5;
    }

    .staff-form-header h5 {
        font-weight: 700;
        color: #172033;
        margin-bottom: 4px;
    }

    .staff-form-header p {
        color: #7b8494;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .staff-form-body {
        padding: 28px;
    }

    .info-box {
        background: #eef5ff;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 24px;
        color: #556274;
        font-size: 0.9rem;
    }

    .section-card {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 22px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .section-title h5 {
        margin-bottom: 2px;
        font-weight: 700;
        color: #172033;
    }

    .section-title p {
        margin-bottom: 0;
        color: #7b8494;
        font-size: 0.84rem;
    }

    .form-label-custom {
        display: block;
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .staff-input {
        min-height: 48px;
        border-radius: 9px;
        border: 1px solid #dce1e8;
    }

    .staff-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.12);
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .form-actions .btn {
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    @@media (max-width: 767px) {
        .staff-edit-page {
            padding-top: 20px;
        }

        .staff-edit-header h2 {
            font-size: 1.7rem;
        }

        .staff-form-body {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<div class="staff-edit-page">

    <!-- PAGE HEADER -->
    <div class="staff-edit-header">

        <h2>Edit Maintenance Staff</h2>

        <p>
            Update maintenance staff information and specialization.
        </p>

    </div>


    <div class="staff-form-card">

        <!-- CARD HEADER -->
        <div class="staff-form-header">

            <h5>Staff Information</h5>

            <p>
                Modify the staff member's profile details.
            </p>

        </div>


        <div class="staff-form-body">

            <div class="info-box">
                Login credentials remain unchanged here.
                This page updates the staff member's profile and specialization.
            </div>


            <form asp-action="Edit"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">
                            S
                        </div>

                        <div>

                            <h5>Maintenance Staff Details</h5>

                            <p>
                                Update contact information and work specialization.
                            </p>

                        </div>

                    </div>


                    <div class="row g-4">


                        <!-- FULL NAME -->
                        <div class="col-md-6">

                            <label asp-for="FullName"
                                   class="form-label-custom">

                                Full Name

                            </label>


                            <input asp-for="FullName"
                                   class="form-control staff-input"
                                   placeholder="Enter staff member name" />


                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PHONE NUMBER -->
                        <div class="col-md-6">

                            <label asp-for="PhoneNumber"
                                   class="form-label-custom">

                                Phone Number

                            </label>


                            <input asp-for="PhoneNumber"
                                   class="form-control staff-input"
                                   placeholder="Enter contact number" />


                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- SPECIALIZATION -->
                        <div class="col-md-12">

                            <label asp-for="Specialization"
                                   class="form-label-custom">

                                Specialization

                            </label>


                            <select asp-for="Specialization"
                                    asp-items="Html.GetEnumSelectList<Hostel_hub.Models.StaffSpecialization>()"
                                    class="form-select staff-input">
                            </select>


                            <span asp-validation-for="Specialization"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}