@model Hostel_hub.ViewModels.MaintenanceStaffEditViewModel

<h2>Edit Maintenance Staff</h2>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-3"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
    <div class="form-group mb-3"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" class="form-control" /></div>
    <div class="form-group mb-3">
        <label asp-for="Specialization"></label>
        <select asp-for="Specialization" asp-items="Html.GetEnumSelectList<Hostel_hub.Models.StaffSpecialization>()" class="form-control"></select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>